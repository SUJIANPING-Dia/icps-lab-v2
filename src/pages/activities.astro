---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import PageHero from "../components/PageHero.astro";

let activities = [];

try {
  const cloudName = import.meta.env.CLOUDINARY_CLOUD_NAME;
  const apiKey = import.meta.env.CLOUDINARY_API_KEY;
  const apiSecret = import.meta.env.CLOUDINARY_API_SECRET;

  const response = await fetch(`https://api.cloudinary.com/v1_1/${cloudName}/resources/search`, {
    method: 'POST',
    headers: {
      'Authorization': `Basic ${btoa(apiKey + ':' + apiSecret)}`,
      'Content-Type': 'application/json'
    },
    body: JSON.stringify({
      expression: '', // 抓取全部照片，由前端進行篩選
      with_field: 'context',
      sort_by: [{ created_at: 'desc' }],
      max_results: 500
    })
  });

  const result = await response.json();

  if (result.resources) {
    const albumsMap = new Map();

    result.resources.forEach(img => {
      // 處理 Cloudinary 虛擬資料夾的問題
      let folderPath = img.asset_folder || img.folder || "";

      if (folderPath.startsWith('events/')) {
        if (folderPath.endsWith('/')) folderPath = folderPath.slice(0, -1);
        
        const albumId = folderPath.split('/').pop();

        if (albumId && albumId !== 'events' && !albumsMap.has(albumId)) {
          albumsMap.set(albumId, {
            id: albumId,
            title: img.context?.custom?.title || albumId,
            date: img.created_at.substring(0, 10).replace(/-/g, '.'),
            img: img.secure_url.replace('/upload/', '/upload/f_auto,q_auto/')
          });
        }
      }
    });

    activities = Array.from(albumsMap.values());
  }
} catch (error) {
  console.error("Cloudinary API 獲取失敗:", error);
}

const pageHeroItems = [
  { label: "ALBUMS", value: "活動相簿", note: "展覽、參訪、競賽與交流紀錄" },
  { label: "EVENTS", value: "現場紀錄", note: "用照片回顧實驗室參與的活動" },
  { label: "UPDATES", value: "近期花絮", note: "依相簿建立時間瀏覽最新活動" },
];

const title = "活動花絮 | iCPS Lab 智慧網宇實體系統實驗室";
const description = "瀏覽 iCPS Lab 活動花絮與相簿紀錄，了解實驗室參訪、展覽、競賽與研究交流活動。";
const bodyClass = "bg-[#f8fafc] text-slate-800 font-sans antialiased selection:bg-blue-200 selection:text-blue-900 relative";
---

<BaseLayout title={title} description={description} bodyClass={bodyClass}>

  <!-- 🔷 頂部導覽列 (Navbar) -->
  <Navbar activePath="/activities" />

  <PageHero
    badgeDetail="Events & Albums"
    eyebrow="LAB EVENTS"
    title="活動花絮"
    description="記錄實驗室參訪、展覽、競賽、國際交流與研究活動，透過相簿快速回顧現場。"
    primaryLabel="瀏覽相簿"
    primaryHref="#main-content"
    secondaryLabel="Activity records and field moments"
    panelLabel="EVENT GUIDE"
    panelTitle="內容索引"
    panelItems={pageHeroItems}
  />

  <main id="main-content" class="max-w-7xl mx-auto px-6 py-16 relative z-20 min-h-screen">
    <div class="mb-10">
      <a href="/" class="inline-flex items-center text-sm font-bold text-slate-500 hover:text-blue-700 transition">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
        返回首頁
      </a>
    </div>

    <!-- 📷 相簿網格區塊 -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {activities.map((item) => (
        <a href={`/activities/${encodeURIComponent(item.id)}`} class="bg-white rounded-md border border-slate-200 overflow-hidden shadow-sm hover:shadow-xl hover:border-blue-300 transition-all duration-300 group flex flex-col cursor-pointer block">
          <div class="relative aspect-[4/3] overflow-hidden bg-slate-100 shrink-0">
            <img src={item.img} alt={item.title} class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-110" loading="lazy" />
            <div class="absolute top-4 left-4 bg-white/90 backdrop-blur-sm text-slate-800 text-xs font-bold px-3 py-1.5 rounded-sm shadow-sm flex items-center gap-1.5">
              📅 {item.date}
            </div>
          </div>

          <div class="p-6 flex flex-col items-center justify-center flex-1 text-center bg-white relative">
            <h3 class="text-lg font-bold text-slate-800 mb-2 leading-snug group-hover:text-blue-700 transition-colors">
              {item.title}
            </h3>
            <div class="mt-3 inline-flex items-center gap-1.5 text-[13px] font-bold text-slate-400 group-hover:text-blue-600 transition-colors">
              觀看相簿 →
            </div>
          </div>
        </a>
      ))}
    </div>
  </main>

  <!-- 共用頁尾包含經驗證的造訪計數器。 -->
  <Footer lang="zh" />
</BaseLayout>
