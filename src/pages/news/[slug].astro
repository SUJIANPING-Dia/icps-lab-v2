---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import { newsData, prepareNewsContent, type NewsItem } from "../../data/news";

export function getStaticPaths() {
  return newsData.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

const { item } = Astro.props as { item: NewsItem };
const title = `${item.title} | iCPS Lab`;
const description = `${item.date} - ${item.title}`;
const bodyClass = "bg-[#f8fafc] text-slate-800 font-sans antialiased selection:bg-blue-200 selection:text-blue-900";
---

<BaseLayout title={title} description={description} bodyClass={bodyClass} image={item.img} imageAlt={item.imgAlt} type="article" publishedTime={item.date.replaceAll(".", "-")}>
  <Fragment slot="head">
    <style is:global>
      .news-detail-content > div > :first-child {
        margin-top: 0;
      }

      .news-detail-content img {
        border-radius: 1.25rem;
      }
    </style>
  </Fragment>

  <Navbar activePath="/news" />

  <main class="min-h-screen relative overflow-hidden">
    <section class="relative overflow-hidden bg-slate-950 text-white border-b border-slate-800">
      <div class="absolute inset-0 pointer-events-none">
        <div class="absolute -left-24 top-16 h-72 w-72 rounded-full bg-blue-500/20 blur-3xl"></div>
        <div class="absolute right-[-8rem] bottom-[-8rem] h-96 w-96 rounded-full bg-cyan-500/10 blur-3xl"></div>
      </div>

      <div class="relative max-w-7xl mx-auto px-6 py-12 sm:py-16 lg:py-20">
        <a href="/news" class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/10 px-4 py-2 text-sm font-bold text-blue-100 backdrop-blur transition hover:bg-white/15 hover:text-white mb-8">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          返回最新消息
        </a>

        <div class="grid lg:grid-cols-12 gap-8 lg:gap-12 items-center">
          <div class="lg:col-span-7">
            <div class="flex flex-wrap items-center gap-3 mb-6">
              <time datetime={item.date.replaceAll(".", "-")} class="text-blue-200 font-mono text-sm tracking-tight">{item.date}</time>
              <span class={`px-2.5 py-1 text-xs font-bold rounded-sm border bg-white ${item.tagTheme}`}>{item.tag}</span>
              {item.isPinned && (
                <span class="px-2 py-0.5 text-[11px] font-bold text-red-200 bg-red-500/15 border border-red-300/30 rounded">
                  置頂
                </span>
              )}
            </div>
            <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight leading-tight">
              {item.title}
            </h1>
            <p class="mt-6 text-slate-300 text-base sm:text-lg leading-relaxed max-w-2xl">
              iCPS Lab 最新消息與研究動態
            </p>
          </div>

          {item.img && (
            <div class="lg:col-span-5">
              <div class="relative overflow-hidden rounded-[2rem] border border-white/15 bg-white/10 p-3 shadow-2xl shadow-blue-950/30 backdrop-blur-xl">
                <div class="overflow-hidden rounded-[1.5rem] bg-white">
                  <img src={item.img} alt={item.imgAlt} class="w-full h-auto max-h-[22rem] object-contain bg-white" loading="lazy" onerror="this.style.display='none';" />
                </div>
                {item.imgAlt && (
                  <p class="px-2 pt-3 text-xs leading-relaxed text-slate-300">
                    {item.imgAlt}
                  </p>
                )}
              </div>
            </div>
          )}
        </div>
      </div>
    </section>

    <article class="max-w-7xl mx-auto px-6 py-12 sm:py-16">
      <div class="grid lg:grid-cols-12 gap-8 lg:gap-10">
        <aside class="lg:col-span-3">
          <div class="lg:sticky lg:top-28 rounded-[1.5rem] bg-white border border-slate-200/80 p-6 shadow-sm">
            <p class="text-xs font-black tracking-[0.18em] text-blue-700 uppercase mb-4">News Detail</p>
            <dl class="space-y-4 text-sm">
              <div>
                <dt class="text-slate-400 font-bold mb-1">日期</dt>
                <dd class="text-slate-800 font-mono">{item.date}</dd>
              </div>
              <div>
                <dt class="text-slate-400 font-bold mb-1">分類</dt>
                <dd>
                  <span class={`inline-flex px-2.5 py-1 text-xs font-medium rounded-sm border ${item.tagTheme}`}>{item.tag}</span>
                </dd>
              </div>
            </dl>
            <a href="/news" class="mt-6 inline-flex w-full items-center justify-center gap-2 rounded-full bg-slate-950 px-4 py-3 text-sm font-bold text-white transition hover:bg-blue-700">
              回到新聞列表
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
              </svg>
            </a>
          </div>
        </aside>

        <section class="lg:col-span-9">
          <div class="news-detail-content rounded-[2rem] bg-white border border-slate-200/80 shadow-sm p-6 sm:p-8 lg:p-10 text-slate-700 text-base leading-relaxed space-y-5">
            {!item.img && (
              <div class="mb-8 rounded-[1.5rem] bg-slate-50 border border-slate-200 p-6">
                <p class="text-sm font-bold text-slate-500">iCPS Lab News</p>
                <p class="mt-2 text-slate-700">{item.title}</p>
              </div>
            )}
            <div set:html={prepareNewsContent(item.content, "zh", item.title)}></div>
          </div>
        </section>
      </div>
    </article>
  </main>

  <Footer lang="zh" margin="auto" />
</BaseLayout>
