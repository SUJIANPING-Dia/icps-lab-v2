---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import PageHero from "../components/PageHero.astro";

const pageHeroItems = [
  { label: "LAB IDENTITY", value: "研究定位", note: "AIoT、邊緣 AI、智慧醫療與智慧製造" },
  { label: "TEAM", value: "教授與團隊", note: "跨域研究、系統實作與人才培育" },
  { label: "COLLABORATION", value: "合作場域", note: "醫療、產業與國際研究交流" },
];

const title = "關於實驗室 | iCPS Lab 智慧網宇實體系統實驗室";
const description = "iCPS Lab 智慧網宇實體系統實驗室介紹、研究方向與合作資訊。";
const bodyClass = "bg-[#f8fafc] text-slate-800 font-sans antialiased selection:bg-blue-200 selection:text-blue-900 relative flex flex-col min-h-screen overflow-x-hidden";
---

<BaseLayout title={title} description={description} bodyClass={bodyClass}>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700;900&family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
  </Fragment>

  <!-- ============================================================ -->
  <!-- 🔒 導覽列：共用元件                                          -->
  <!-- ============================================================ -->
  <Navbar activePath="/about" />

  <PageHero
    badgeDetail="About iCPS Lab"
    eyebrow="LAB IDENTITY"
    title="關於我們"
    description="iCPS Lab 聚焦 AIoT、邊緣 AI、智慧醫療與智慧製造，將研究成果推進到真實場域與跨域合作。"
    primaryLabel="了解研究定位"
    primaryHref="#mission"
    secondaryLabel="AI-enabled systems for real-world impact"
    panelLabel="LAB MAP"
    panelTitle="內容索引"
    panelItems={pageHeroItems}
  />

  <main id="main-content" class="flex-grow relative z-20 w-full">

    <!-- Sticky page tabs -->
    <div class="sticky top-0 z-20 bg-[#f8fafc]/85 backdrop-blur-xl border-b border-slate-200/70">
      <div class="max-w-7xl mx-auto px-6 py-3 overflow-x-auto scrollbar-hide">
        <div class="flex items-center gap-2 min-w-max text-sm font-bold text-slate-500">
          <a href="#mission" class="page-tab px-4 py-2 rounded-full hover:bg-white hover:text-blue-700 hover:shadow-sm transition">實驗室定位</a>
          <a href="#pi" class="page-tab px-4 py-2 rounded-full hover:bg-white hover:text-blue-700 hover:shadow-sm transition">實驗室領航</a>
          <a href="#collaboration" class="page-tab px-4 py-2 rounded-full hover:bg-white hover:text-blue-700 hover:shadow-sm transition">合作與人才</a>
          <a href="#research" class="page-tab px-4 py-2 rounded-full hover:bg-white hover:text-blue-700 hover:shadow-sm transition">核心研究</a>
          <a href="#journey" class="page-tab px-4 py-2 rounded-full hover:bg-white hover:text-blue-700 hover:shadow-sm transition">加入我們</a>
        </div>
      </div>
    </div>

    <div class="max-w-7xl mx-auto px-6 py-16 lg:py-24 space-y-24 lg:space-y-32">

      <!-- Mission -->
      <section id="mission" class="scroll-mt-28">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start">
          <div class="lg:col-span-5 rv rv-left">
            <div class="inline-flex items-center gap-3 mb-5">
              <span class="w-10 h-1 bg-blue-600 rounded-full"></span>
              <span class="text-blue-600 text-xs font-black tracking-[0.25em] uppercase">Lab Positioning</span>
            </div>
            <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-950 tracking-tight leading-tight">
              不是單點技術展示，<br />而是完整系統解題。
            </h2>
            <p class="mt-6 text-slate-600 leading-relaxed text-base lg:text-lg">
              iCPS Lab 的核心價值，是把人工智慧、感測資料與實體場域整合成可部署、可驗證、可持續改善的系統。研究從問題定義開始，最後回到醫療、製造與智慧城市等真實應用場景。
            </p>
          </div>

          <div class="lg:col-span-7 rv rv-right">
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
              <article class="process-card group bg-white rounded-[1.75rem] p-6 border border-slate-200/70 shadow-sm hover:shadow-xl transition-all duration-500 hover:-translate-y-1">
                <div class="w-12 h-12 rounded-2xl bg-blue-50 text-blue-700 flex items-center justify-center mb-5 group-hover:bg-blue-600 group-hover:text-white transition-all duration-300">
                  <span class="font-black">01</span>
                </div>
                <h3 class="font-black text-slate-900 text-lg mb-2">感測資料</h3>
                <p class="text-slate-500 text-sm leading-relaxed">從影像、ToF、熱影像與感測訊號取得可信任的場域資料。</p>
              </article>
              <article class="process-card group bg-white rounded-[1.75rem] p-6 border border-slate-200/70 shadow-sm hover:shadow-xl transition-all duration-500 hover:-translate-y-1 rv-delay-100">
                <div class="w-12 h-12 rounded-2xl bg-cyan-50 text-cyan-700 flex items-center justify-center mb-5 group-hover:bg-cyan-600 group-hover:text-white transition-all duration-300">
                  <span class="font-black">02</span>
                </div>
                <h3 class="font-black text-slate-900 text-lg mb-2">AI 判讀</h3>
                <p class="text-slate-500 text-sm leading-relaxed">透過模型設計、訓練與驗證，把資料轉化為可解釋的決策依據。</p>
              </article>
              <article class="process-card group bg-white rounded-[1.75rem] p-6 border border-slate-200/70 shadow-sm hover:shadow-xl transition-all duration-500 hover:-translate-y-1 rv-delay-200">
                <div class="w-12 h-12 rounded-2xl bg-slate-100 text-slate-800 flex items-center justify-center mb-5 group-hover:bg-slate-900 group-hover:text-white transition-all duration-300">
                  <span class="font-black">03</span>
                </div>
                <h3 class="font-black text-slate-900 text-lg mb-2">系統落地</h3>
                <p class="text-slate-500 text-sm leading-relaxed">結合邊緣運算與人機介面，讓技術進入臨床、產線與實際場域。</p>
              </article>
            </div>

            <div class="mt-5 bg-gradient-to-r from-slate-900 to-blue-950 rounded-[1.75rem] p-7 sm:p-8 overflow-hidden relative shadow-xl">
              <div class="absolute top-0 right-0 w-80 h-80 bg-blue-500/20 rounded-full blur-3xl translate-x-1/2 -translate-y-1/2"></div>
              <div class="relative z-10 flex flex-col md:flex-row md:items-center gap-6 justify-between">
                <div>
                  <p class="text-blue-300 text-xs font-black tracking-[0.22em] uppercase mb-2">Research Philosophy</p>
                  <h3 class="text-white text-2xl sm:text-3xl font-black leading-snug">從場域問題出發，讓研究成果被真正使用。</h3>
                </div>
                <a href="/achievements" class="shrink-0 inline-flex items-center justify-center gap-2 bg-white text-slate-900 px-5 py-3 rounded-full font-bold text-sm hover:bg-blue-50 transition">
                  查看成果榮譽
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
                </a>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Principal Investigator -->
      <section id="pi" class="scroll-mt-28">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-stretch">
          <div class="lg:col-span-5 rv rv-left">
            <div class="relative h-full min-h-[420px] rounded-[2.25rem] overflow-hidden bg-slate-900 shadow-2xl group">
              <img src="/images/professor-chang.webp" alt="張萬榮 教授" class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" decoding="async" onerror="this.src='/images/professor.webp';" />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/20 to-transparent"></div>
              <div class="absolute left-6 right-6 bottom-6">
                <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/15 text-white text-[11px] font-bold tracking-widest uppercase backdrop-blur border border-white/20 mb-4">Principal Investigator</div>
                <h2 class="text-white text-3xl font-black">張萬榮 教授</h2>
                <p class="text-blue-200 mt-1 font-medium">Wan-Jung Chang, Ph.D.</p>
              </div>
            </div>
          </div>

          <div class="lg:col-span-7 rv rv-right">
            <div class="h-full bg-white border border-slate-200/70 rounded-[2.25rem] p-8 sm:p-10 lg:p-12 shadow-sm relative overflow-hidden">
              <div class="absolute top-0 right-0 w-72 h-72 bg-blue-50 rounded-full blur-3xl translate-x-1/3 -translate-y-1/3"></div>
              <div class="relative z-10">
                <div class="inline-flex items-center gap-3 mb-5">
                  <span class="w-9 h-1 bg-blue-600 rounded-full"></span>
                  <span class="text-blue-600 text-xs font-black tracking-[0.25em] uppercase">Lab Leadership</span>
                </div>
                <h3 class="text-3xl sm:text-4xl font-black text-slate-950 tracking-tight mb-6">跨域整合訓練，培養解題的工程人才。</h3>
                <blockquote class="relative pl-5 border-l-4 border-blue-500 mb-7">
                  <p class="text-slate-700 text-lg leading-relaxed font-medium">
                    「工程教育的價值在於探索未知，並將科技回饋社會。我們期許團隊不僅掌握前瞻技術，更能為臨床與產業提出切實可行的解方。」
                  </p>
                </blockquote>
                <p class="text-slate-600 leading-relaxed mb-7">
                  張教授深耕 AIoT 與邊緣運算多年，在高科大電子工程系建構高度跨域協作的研究環境。對外橋接醫療院所與科技產業，對內引導學生在紮實學理基礎上，將創意轉化為可驗證的系統成果。
                </p>

                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-8">
                  <div class="rounded-2xl bg-slate-50 border border-slate-100 p-4">
                    <div class="text-slate-900 font-black">AIoT</div>
                    <div class="text-xs text-slate-500 mt-1">智慧感測整合</div>
                  </div>
                  <div class="rounded-2xl bg-slate-50 border border-slate-100 p-4">
                    <div class="text-slate-900 font-black">Edge AI</div>
                    <div class="text-xs text-slate-500 mt-1">邊緣部署應用</div>
                  </div>
                  <div class="rounded-2xl bg-slate-50 border border-slate-100 p-4">
                    <div class="text-slate-900 font-black">XR</div>
                    <div class="text-xs text-slate-500 mt-1">沉浸式訓練系統</div>
                  </div>
                </div>

                <div class="flex flex-col sm:flex-row gap-3">
                  <a href="https://ec.nkust.edu.tw/p/404-1122-98302.php?Lang=zh-tw" target="_blank" rel="noopener noreferrer" class="inline-flex justify-center items-center gap-2 bg-slate-900 hover:bg-blue-700 text-white px-5 py-3 rounded-full font-bold text-sm transition hover:-translate-y-0.5">
                    查看完整簡歷
                  </a>
                  <a href="mailto:allenchang@nkust.edu.tw" class="inline-flex justify-center items-center gap-2 bg-white hover:bg-blue-50 text-slate-700 hover:text-blue-700 border border-slate-200 hover:border-blue-200 px-5 py-3 rounded-full font-bold text-sm transition hover:-translate-y-0.5">
                    寄信聯繫教授
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Collaboration / Students -->
      <section id="collaboration" class="scroll-mt-28">
        <div class="text-center max-w-3xl mx-auto mb-12 rv rv-up">
          <div class="inline-flex items-center gap-3 mb-4">
            <span class="w-8 h-1 bg-blue-600 rounded-full"></span>
            <span class="text-blue-600 text-xs font-black tracking-[0.25em] uppercase">Two-Way Impact</span>
            <span class="w-8 h-1 bg-blue-600 rounded-full"></span>
          </div>
          <h2 class="text-3xl sm:text-4xl font-black text-slate-950 tracking-tight">對外連結產醫場域，對內培養研究人才。</h2>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-8">
          <article class="impact-card group relative overflow-hidden rounded-[2rem] bg-slate-950 p-8 sm:p-10 min-h-[430px] shadow-xl rv rv-left">
            <div class="absolute inset-0 bg-[radial-gradient(circle_at_80%_20%,rgba(37,99,235,0.38),transparent_32%),linear-gradient(135deg,#020617,#0f172a)]"></div>
            <div class="absolute right-0 bottom-0 w-80 h-80 bg-blue-600/10 rounded-full blur-3xl translate-x-1/3 translate-y-1/3"></div>
            <div class="relative z-10 h-full flex flex-col">
              <div class="w-14 h-14 rounded-2xl bg-blue-500/20 border border-blue-400/25 text-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition">🤝</div>
              <p class="text-blue-300 text-xs font-black tracking-[0.24em] uppercase mb-3">For Partners</p>
              <h3 class="text-3xl font-black text-white mb-5">產醫跨域合作</h3>
              <p class="text-slate-300 leading-relaxed mb-7">
                我們具備產學合作與臨床場域驗證經驗，能為企業與醫院提供客製化技術評估、AI 系統開發與 PoC 驗證，協助把研究概念推進到實際應用。
              </p>
              <ul class="space-y-3 text-sm text-slate-300 mb-8">
                <li class="flex gap-3"><span class="text-blue-300">✓</span><span>臨床痛點 AI 輔助系統開發</span></li>
                <li class="flex gap-3"><span class="text-blue-300">✓</span><span>智慧工廠瑕疵檢測與自動化導入</span></li>
                <li class="flex gap-3"><span class="text-blue-300">✓</span><span>前瞻技術轉移與聯合研發</span></li>
              </ul>
              <a href="mailto:allenchang@nkust.edu.tw" class="mt-auto inline-flex w-max items-center gap-2 bg-blue-600 hover:bg-blue-500 text-white font-bold px-5 py-3 rounded-full text-sm transition hover:-translate-y-0.5">
                提案與洽詢合作
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
              </a>
            </div>
          </article>

          <article class="impact-card group relative overflow-hidden rounded-[2rem] bg-white border border-slate-200/70 p-8 sm:p-10 min-h-[430px] shadow-sm hover:shadow-xl transition rv rv-right rv-delay-100">
            <div class="absolute top-0 right-0 w-72 h-72 bg-blue-50 rounded-full blur-3xl translate-x-1/2 -translate-y-1/2 group-hover:bg-blue-100 transition"></div>
            <div class="relative z-10 h-full flex flex-col">
              <div class="w-14 h-14 rounded-2xl bg-blue-50 text-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition">🎓</div>
              <p class="text-blue-600 text-xs font-black tracking-[0.24em] uppercase mb-3">For Students</p>
              <h3 class="text-3xl font-black text-slate-950 mb-5">啟動研究生涯</h3>
              <p class="text-slate-600 leading-relaxed mb-7">
                歡迎博碩士與大學部專題生加入。你將不只學理論，而會真正參與資料處理、模型訓練、系統整合、論文發表與競賽實作。
              </p>
              <ul class="space-y-3 text-sm text-slate-700 mb-8 font-medium">
                <li class="flex gap-3"><span class="text-blue-600">✓</span><span>從演算法開發到系統落地的完整訓練</span></li>
                <li class="flex gap-3"><span class="text-blue-600">✓</span><span>輔導發表國內外研討會與期刊</span></li>
                <li class="flex gap-3"><span class="text-blue-600">✓</span><span>累積創新競賽與產學專案實戰履歷</span></li>
              </ul>
              <a href="/members" class="mt-auto inline-flex w-max items-center gap-2 bg-slate-900 hover:bg-blue-700 text-white font-bold px-5 py-3 rounded-full text-sm transition hover:-translate-y-0.5">
                認識實驗室學長姐
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
              </a>
            </div>
          </article>
        </div>
      </section>

      <!-- Core Research -->
      <section id="research" class="scroll-mt-28">
        <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6 mb-12 rv rv-up">
          <div>
            <div class="inline-flex items-center gap-3 mb-4">
              <span class="w-10 h-1 bg-blue-600 rounded-full"></span>
              <span class="text-blue-600 text-xs font-black tracking-[0.25em] uppercase">Core Applications</span>
            </div>
            <h2 class="text-3xl sm:text-4xl font-black text-slate-950 tracking-tight">三大核心研究領域</h2>
          </div>
          <p class="text-slate-500 max-w-xl leading-relaxed">以 AIoT 為技術主軸，串接智慧醫療、智慧製造與智慧交通，讓模型不只停留在準確率，而是進一步形成可部署的應用系統。</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <article class="research-card group rounded-[2rem] bg-white border border-slate-200/70 p-7 shadow-sm hover:shadow-2xl hover:-translate-y-2 transition-all duration-500 rv rv-up">
            <div class="h-44 rounded-[1.5rem] bg-gradient-to-br from-red-50 to-white mb-6 flex items-center justify-center overflow-hidden relative">
              <div class="absolute w-36 h-36 bg-red-200/50 rounded-full blur-2xl group-hover:scale-125 transition duration-700"></div>
              <svg class="relative z-10 w-16 h-16 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" /></svg>
            </div>
            <p class="text-red-500 text-xs font-black tracking-widest uppercase mb-2">Healthcare AI</p>
            <h3 class="text-xl font-black text-slate-950 mb-4">數位醫療與智慧照護</h3>
            <p class="text-slate-600 text-sm leading-relaxed text-justify">整合熱影像、ToF 感測器與 AI 骨幹辨識，應用於精神病房自傷預警、病患行為辨識、耳病灶自動診斷、舌肌復健與手術器械教育訓練 XR 平台。</p>
          </article>

          <article class="research-card group rounded-[2rem] bg-white border border-slate-200/70 p-7 shadow-sm hover:shadow-2xl hover:-translate-y-2 transition-all duration-500 rv rv-up rv-delay-100">
            <div class="h-44 rounded-[1.5rem] bg-gradient-to-br from-amber-50 to-white mb-6 flex items-center justify-center overflow-hidden relative">
              <div class="absolute w-36 h-36 bg-amber-200/50 rounded-full blur-2xl group-hover:scale-125 transition duration-700"></div>
              <svg class="relative z-10 w-16 h-16 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
            </div>
            <p class="text-amber-500 text-xs font-black tracking-widest uppercase mb-2">Smart Manufacturing</p>
            <h3 class="text-xl font-black text-slate-950 mb-4">工業 4.0 智能製造</h3>
            <p class="text-slate-600 text-sm leading-relaxed text-justify">導入 Edge AI 邊緣運算，針對電容缺漏焊、產品包裝缺陷等痛點，開發低延遲、高精準度的自動化產線瑕疵檢測系統。</p>
          </article>

          <article class="research-card group rounded-[2rem] bg-white border border-slate-200/70 p-7 shadow-sm hover:shadow-2xl hover:-translate-y-2 transition-all duration-500 rv rv-up rv-delay-200">
            <div class="h-44 rounded-[1.5rem] bg-gradient-to-br from-emerald-50 to-white mb-6 flex items-center justify-center overflow-hidden relative">
              <div class="absolute w-36 h-36 bg-emerald-200/50 rounded-full blur-2xl group-hover:scale-125 transition duration-700"></div>
