const undergradProjectSummaries: Record<string, string> = {
  "AI銀髮族體適能健身系統": "This project combines multi-model pose recognition and monocular 3D localization to evaluate exercise quality for older adults, balancing accuracy, privacy, and reduced manual workload.",
  "AI手術器械辨識": "This project combines YOLO-based surgical instrument recognition with LLM-generated guidance to provide real-time feedback for novice nurses and reduce clinical teaching workload.",
  "AI膝反射辨識系統": "This project integrates AI image recognition and conductive-yarn sensing to build an automated knee-reflex measurement system for objective clinical assessment and follow-up.",
  "AI塑膠微粒辨識系統": "This project applies YOLO deep learning to microscopic microplastic images, improving classification efficiency and reducing manual interpretation errors for standardized environmental monitoring.",
  "AI電容焊接瑕疵辨識": "This project combines YOLO deep learning and edge computing to detect missing or defective capacitor soldering around CPUs, improving production-line accuracy and stability.",
  "AI豬隻健康辨識系統": "This project combines YOLO and image processing to estimate pig body weight quickly and accurately, reducing animal stress while improving feeding efficiency and operational safety.",
  "AI調料包缺陷辨識系統": "This project designs an AI seasoning-packet inspection system for noodle production lines, combining cameras and edge AI to detect packet type and quantity in real time while improving inspection accuracy.",
};

const today = new Date();
let currentAcYear = today.getFullYear() - 1911;
if (today.getMonth() < 7) currentAcYear -= 1;

function getGradeText(degree: string, enrollYear: number): string {
  let diff = currentAcYear - enrollYear + 1;
  if (diff < 1) diff = 1;
  if (degree === 'master') return diff > 2 ? `M${diff} (extended)` : `M${diff}`;
  if (degree === 'phd') return diff > 4 ? `PhD ${diff} (extended)` : `PhD ${diff}`;
  return diff > 4 ? `Year ${diff} (extended)` : `Year ${diff}`;
}

function getAvatar(img: string | null | undefined, name: string): string {
  if (img && img.trim() !== '') return img;
  return `https://ui-avatars.com/api/?name=${encodeURIComponent(name)}&background=E2E8F0&color=475569&bold=true`;
}

const phds         = allStudents.filter(s => s.status === 'active' && s.degree === 'phd');
const masters      = allStudents.filter(s => s.status === 'active' && s.degree === 'master');
const undergrads   = allStudents.filter(s => s.status === 'active' && s.degree === 'undergrad');
const internationals = allStudents.filter(s => s.status === 'active' && s.degree === 'international');
const graduates    = allStudents.filter(s => s.status === 'graduated');

const mastersByYear = masters.reduce((map, student) => {
  const yr = student.enrollmentYear ?? 0;
  if (!map[yr]) map[yr] = [];
  map[yr].push(student);
  return map;
}, {} as Record<number, typeof masters>);
const sortedMasterYears = Object.keys(mastersByYear).map(Number).sort((a, b) => a - b);

const phdsByYear = phds.reduce((map, student) => {
  const yr = student.enrollmentYear ?? 0;
  if (!map[yr]) map[yr] = [];
  map[yr].push(student);
  return map;
}, {} as Record<number, typeof phds>);
const sortedPhdYears = Object.keys(phdsByYear).map(Number).sort((a, b) => a - b);

const undergradByYear = undergrads.reduce((yearMap, student) => {
  const yr = student.enrollmentYear ?? 0;
  if (!yearMap[yr]) yearMap[yr] = {};
  const projectName = student.project || 'Uncategorized Project';
  if (!yearMap[yr][projectName]) yearMap[yr][projectName] = [];
  yearMap[yr][projectName].push(student);
  return yearMap;
}, {} as Record<number, Record<string, typeof undergrads>>);
const sortedUndergradYears = Object.keys(undergradByYear).map(Number).sort((a, b) => a - b);

const groupedGraduates = graduates.reduce((groups, student) => {
  const y = student.graduationYear ?? 'Unknown Year';
  const key = String(y);
  if (!groups[key]) groups[key] = [];
  groups[key].push(student);
  return groups;
}, {} as Record<string, typeof graduates>);
const sortedGradYears = Object.keys(groupedGraduates).sort((a, b) => Number(b) - Number(a));

// --- UI summary only: does not change enrollment / graduation / grade rules ---
const activeStudentCount = phds.length + masters.length + undergrads.length + internationals.length;
const totalMemberCount = 1 + assistants.length + activeStudentCount;
const pageHeroItems = [
  { label: "DIRECTOR", value: "Principal Investigator", note: "Research leadership, collaboration, and student training" },
  { label: "STUDENTS", value: `${activeStudentCount} students`, note: "Graduate students and undergraduate project teams" },
  { label: "DIRECTORY", value: `${totalMemberCount} members`, note: "Faculty, managers, and current lab members" },
];

const title = "Members | iCPS Lab";
const description = "Meet the iCPS Lab principal investigator, administrative team, graduate students, undergraduate project teams, international students, and alumni.";
const bodyClass = "bg-[#f8fafc] text-slate-800 font-sans antialiased selection:bg-blue-200 selection:text-blue-900 relative";

---

<BaseLayout title={title} description={description} bodyClass={bodyClass} lang="en">
  <Fragment slot="head">
    <style is:global>
    /* =====================================================
       ✨ 動畫系統 v2 — Scroll Reveal + 頁籤過渡
    ===================================================== */

    /* --- Scroll Reveal 基底 --- */
    [data-rv] {
      opacity: 0;
      transition:
        opacity  0.7s cubic-bezier(0.22, 1, 0.36, 1),
        transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
    }
    [data-rv="up"]    { transform: translateY(32px); }
    [data-rv="left"]  { transform: translateX(-32px); }
    [data-rv="right"] { transform: translateX(32px); }
    [data-rv="fade"]  { transform: none; }
    [data-rv="zoom"]  { transform: scale(0.97); }

    [data-rv].rv-visible {
      opacity: 1;
      transform: translate(0, 0) scale(1);
    }

    /* 延遲 helpers（套在子元素上） */
    .rv-d1 { transition-delay: 80ms !important; }
    .rv-d2 { transition-delay: 160ms !important; }
    .rv-d3 { transition-delay: 240ms !important; }
    .rv-d4 { transition-delay: 320ms !important; }
    .rv-d5 { transition-delay: 400ms !important; }

    /* --- 頁籤內容 — 切換動畫 --- */
    .tab-panel {
      display: none;
    }
    .tab-panel[hidden] {
      display: none !important;
    }
    .tab-panel.tab-active {
      display: block;
      animation: tabEnter 0.4s cubic-bezier(0.22, 1, 0.36, 1) both;
    }
    @keyframes tabEnter {
      from { opacity: 0; transform: translateY(10px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    /* --- 卡片 hover glow --- */
    .member-card {
      transition: box-shadow 0.3s ease, border-color 0.3s ease, transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .member-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 8px 28px -4px rgba(59, 130, 246, 0.13), 0 2px 8px -2px rgba(0,0,0,0.06);
      border-color: #bfdbfe;
    }

    /* 大學部專題卡特有 hover */
    .project-card {
      transition: box-shadow 0.3s ease, border-color 0.3s ease, transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .project-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 8px 28px -4px rgba(59, 130, 246, 0.13);
      border-color: #93c5fd;
    }

    /* 助理卡片 avatar hover */
    .assistant-card:hover .assistant-avatar {
      box-shadow: 0 0 0 3px #bfdbfe;
    }
    .assistant-avatar {
      transition: box-shadow 0.3s ease;
    }

    /* 教授卡片研究興趣列 hover */
    .interest-row {
      transition: background 0.2s ease;
      border-radius: 6px;
      padding: 6px 8px;
      margin: -6px -8px;
    }
    .interest-row:hover {
      background: #f1f5f9;
    }

    /* 頁籤按鈕下底線滑動效果 */
    .tab-btn {
      position: relative;
      transition: color 0.25s ease;
    }
    .tab-btn::after {
      content: '';
      position: absolute;
      bottom: -2px;
      left: 0;
      right: 0;
      height: 2px;
      background: #1d4ed8;
      border-radius: 2px 2px 0 0;
      transform: scaleX(0);
      transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .tab-btn.tab-active-style::after { transform: scaleX(1); }

    /* 成員照片懸停縮放 */
    .avatar-zoom {
      transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .member-card:hover .avatar-zoom,
    .project-card:hover .avatar-zoom {
      transform: scale(1.05);
    }

    /* 年度標題進場線 */
    .year-divider-line {
      flex: 1;
      height: 1px;
      background: linear-gradient(to right, #e2e8f0, transparent);
    }


    /* =====================================================
       UIUX Refresh — content presentation only
       不影響 currentAcYear / getGradeText / 升學畢業分組規則
    ===================================================== */
    :root {
      --icps-blue: #2563eb;
      --icps-blue-dark: #1e3a8a;
      --icps-ink: #0f172a;
      --icps-soft: #f8fafc;
    }

    .page-shell {
      background:
        radial-gradient(circle at 12% 0%, rgba(37, 99, 235, 0.10), transparent 30%),
        radial-gradient(circle at 90% 18%, rgba(14, 165, 233, 0.10), transparent 28%),
        linear-gradient(180deg, #f8fafc 0%, #ffffff 42%, #f8fafc 100%);
    }

    .content-panel {
      position: relative;
      overflow: hidden;
      background: rgba(255, 255, 255, 0.88);
      border: 1px solid rgba(226, 232, 240, 0.9);
      box-shadow: 0 24px 70px -45px rgba(15, 23, 42, 0.35);
      backdrop-filter: blur(16px);
    }

    .content-panel::before {
      content: '';
      position: absolute;
      inset: 0 0 auto 0;
      height: 4px;
      background: linear-gradient(90deg, #1d4ed8, #38bdf8, #93c5fd);
    }

    .section-heading {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 1rem;
      margin-bottom: 1.5rem;
    }

    .section-kicker {
      display: inline-flex;
      align-items: center;
      gap: 0.55rem;
      color: #2563eb;
      font-weight: 900;
      font-size: 0.72rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      margin-bottom: 0.55rem;
    }
    .section-kicker::before {
      content: '';
      width: 2rem;
      height: 0.18rem;
      border-radius: 999px;
      background: currentColor;
      opacity: .85;
    }

    .quick-nav {
      background: rgba(255, 255, 255, 0.86);
      border: 1px solid rgba(226, 232, 240, 0.9);
      backdrop-filter: blur(14px);
      box-shadow: 0 18px 50px -35px rgba(15, 23, 42, 0.35);
    }
    .quick-link {
      transition: all .22s cubic-bezier(.22,1,.36,1);
    }
    .quick-link:hover {
      transform: translateY(-1px);
      background: #eff6ff;
      color: #1d4ed8;
    }

    .metric-card {
      position: relative;
      overflow: hidden;
      border: 1px solid rgba(226, 232, 240, .85);
      background: linear-gradient(180deg, rgba(255,255,255,.96), rgba(248,250,252,.86));
      box-shadow: 0 10px 30px -25px rgba(15, 23, 42, .35);
    }
    .metric-card::after {
      content: '';
      position: absolute;
      right: -1.2rem;
      top: -1.2rem;
      width: 4.2rem;
      height: 4.2rem;
      border-radius: 999px;
      background: rgba(37, 99, 235, .08);
    }

    .profile-panel {
      border-radius: 1.75rem;
      background: linear-gradient(135deg, rgba(255,255,255,.96), rgba(248,250,252,.92));
      border: 1px solid rgba(226,232,240,.95);
      box-shadow: 0 24px 80px -50px rgba(15,23,42,.4);
    }

    .member-card, .project-card, .assistant-card {
      border-radius: 1.35rem !important;
      background: rgba(255,255,255,.96) !important;
      box-shadow: 0 10px 35px -30px rgba(15,23,42,.32);
    }
    .member-card:hover, .project-card:hover, .assistant-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 22px 55px -36px rgba(29,78,216,.45), 0 8px 22px -18px rgba(15,23,42,.28);
      border-color: #93c5fd !important;
    }

    .student-tabs-wrap {
      position: sticky;
      top: 0;
      z-index: 20;
      border: 1px solid rgba(226,232,240,.92);
      background: rgba(255,255,255,.88);
      backdrop-filter: blur(16px);
      box-shadow: 0 18px 45px -35px rgba(15,23,42,.32);
      border-radius: 1.25rem;
      padding: .45rem;
      margin-bottom: 2rem;
    }
    .student-tabs-wrap nav { gap: .35rem; }
    .student-tabs-wrap .tab-btn {
      border-bottom: 0 !important;
      border-radius: 1rem;
      padding: .8rem 1rem;
    }
    .student-tabs-wrap .tab-btn::after { display: none; }
    .student-tabs-wrap .tab-active-style {
      background: #eff6ff;
      box-shadow: inset 0 0 0 1px #bfdbfe;
    }

    .year-chip {
      display: inline-flex;
      align-items: center;
      gap: .5rem;
      padding: .55rem .8rem;
      border-radius: 999px;
      background: white;
      border: 1px solid #e2e8f0;
      box-shadow: 0 6px 20px -18px rgba(15,23,42,.4);
    }

    .avatar-frame {
      background: linear-gradient(135deg, #dbeafe, #f8fafc);
      padding: 3px;
      box-shadow: 0 10px 28px -22px rgba(15,23,42,.45);
    }

    @media (max-width: 768px) {
      .section-heading { align-items: flex-start; flex-direction: column; }
      .student-tabs-wrap { top: 0; border-radius: 1rem; }
    }

    </style>
  </Fragment>

  <!-- =============================================================== -->
  <!-- 🔒 導覽列 — 使用共用 Navbar                                    -->
  <!-- =============================================================== -->
  <Navbar activePath="/en/members" lang="en" />

  <PageHero
    badgeDetail="Laboratory Members"
    eyebrow="PEOPLE DIRECTORY"
    title="Members"
    description="Meet the iCPS Lab principal investigator, administrative team, graduate students, undergraduate project teams, international students, and alumni."
    primaryLabel="Browse Members"
    primaryHref="#main-content"
    secondaryLabel="Research teams and project groups"
    panelLabel="TEAM INDEX"
    panelTitle="Section Guide"
    panelItems={pageHeroItems}
  />

  <main id="main-content" class="page-shell relative z-20 min-h-screen overflow-hidden">
    <div class="absolute top-0 left-0 w-72 h-72 bg-blue-100/50 rounded-full blur-3xl -translate-x-1/2 -translate-y-1/3 pointer-events-none"></div>
    <div class="absolute top-[35rem] right-0 w-96 h-96 bg-cyan-100/40 rounded-full blur-3xl translate-x-1/2 pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-6 py-12 lg:py-16 relative z-10">
      <!-- 返回首頁 -->
      <div class="mb-8" data-rv="left">
        <a href="/en" class="inline-flex items-center gap-1.5 text-sm font-semibold text-slate-500 hover:text-blue-700 transition-all duration-200 bg-white/90 px-4 py-2 rounded-full shadow-sm border border-slate-200 hover:shadow-md hover:-translate-x-0.5 group backdrop-blur">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition-transform duration-200 group-hover:-translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
          Back to Home
        </a>
