---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/Navbar.astro";

const title = "About iCPS Lab | Intelligent Cyber-Physical Systems Lab";
const description = "An English prototype page introducing iCPS Lab research focus, system-building approach, collaboration fields, and student training.";
const bodyClass = "bg-[#f8fafc] text-slate-800 font-sans antialiased selection:bg-blue-200 selection:text-blue-900 relative flex flex-col min-h-screen overflow-x-hidden";
---

<BaseLayout title={title} description={description} bodyClass={bodyClass} lang="en">
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700;900&family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
  </Fragment>

  <Navbar activePath="/en/about" lang="en" />

  <header class="relative overflow-hidden bg-slate-950 border-b border-slate-800">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_20%_25%,rgba(37,99,235,0.28),transparent_32%),radial-gradient(circle_at_80%_20%,rgba(14,165,233,0.18),transparent_34%),linear-gradient(135deg,#020617_0%,#0f172a_52%,#071327_100%)]"></div>
    <div class="absolute inset-0 bg-[linear-gradient(rgba(255,255,255,0.035)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.035)_1px,transparent_1px)] bg-[size:56px_56px] opacity-30"></div>
    <div class="absolute bottom-0 left-0 right-0 h-24 bg-gradient-to-t from-[#f8fafc] to-transparent"></div>

    <div class="relative z-10 max-w-7xl mx-auto px-6 py-20 lg:py-28">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
        <div class="lg:col-span-7">
          <a href="/about" class="inline-flex items-center gap-2 text-xs font-bold tracking-widest uppercase text-blue-200 bg-white/5 border border-white/10 px-4 py-2 rounded-full backdrop-blur-md mb-8 hover:bg-white/10 transition">
            View Chinese Version
          </a>
          <p class="text-blue-300 font-black tracking-[0.28em] uppercase text-xs sm:text-sm mb-4">About iCPS Lab</p>
          <h1 class="text-4xl sm:text-5xl lg:text-7xl font-black text-white tracking-tight leading-[1.05]">
            Building AI systems<br />
            that work in the <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-300 via-cyan-200 to-white">real world</span>.
          </h1>
          <p class="mt-7 text-slate-300 text-base sm:text-lg leading-relaxed max-w-2xl">
            The Intelligent Cyber-Physical Systems Lab focuses on AIoT, edge computing, smart healthcare, and smart manufacturing. We connect sensing, AI modeling, and deployment to build systems that address real field needs.
          </p>
          <div class="mt-9 flex flex-col sm:flex-row gap-3">
            <a href="#mission" class="inline-flex justify-center items-center gap-2 bg-blue-600 hover:bg-blue-500 text-white font-bold px-6 py-3 rounded-full shadow-lg shadow-blue-950/30 transition hover:-translate-y-0.5">
              Explore the Lab
            </a>
            <a href="mailto:allenchang@nkust.edu.tw" class="inline-flex justify-center items-center gap-2 bg-white/10 hover:bg-white/15 text-white font-bold px-6 py-3 rounded-full border border-white/15 backdrop-blur transition hover:-translate-y-0.5">
              Contact Us
            </a>
          </div>
        </div>

        <div class="lg:col-span-5">
          <div class="relative overflow-hidden bg-white/10 backdrop-blur-xl border border-white/15 rounded-[2rem] p-6 sm:p-7 shadow-2xl">
            <div class="absolute inset-0 bg-[radial-gradient(circle_at_20%_20%,rgba(59,130,246,0.35),transparent_28%),radial-gradient(circle_at_85%_15%,rgba(34,211,238,0.18),transparent_30%)]"></div>
            <div class="relative z-10">
              <p class="text-blue-200 text-xs font-black tracking-[0.24em] uppercase mb-2">System Workflow</p>
              <h2 class="text-white text-2xl sm:text-3xl font-black tracking-tight mb-8">From data to field deployment</h2>
              <div class="space-y-4">
                {[
                  ["01", "Sensing", "Collect images, ToF signals, thermal data, and field-specific sensor streams."],
                  ["02", "AI Modeling", "Train and validate models that turn raw data into actionable decisions."],
                  ["03", "Edge Deploy", "Bring real-time feedback into clinical, industrial, and human-centered environments."]
                ].map(([step, heading, copy]) => (
                  <div class="flex items-center gap-4 rounded-2xl bg-white/10 border border-white/10 p-4">
                    <div class="w-12 h-12 rounded-xl bg-blue-400/15 border border-blue-300/20 flex items-center justify-center shrink-0 text-blue-200 font-black">{step}</div>
                    <div>
                      <h3 class="text-white font-black text-lg">{heading}</h3>
                      <p class="text-slate-400 text-sm mt-0.5">{copy}</p>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </header>

  <main class="flex-grow">
    <div class="max-w-7xl mx-auto px-6 py-16 lg:py-24 space-y-20">
      <section id="mission" class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start">
        <div class="lg:col-span-5">
          <div class="inline-flex items-center gap-3 mb-5">
            <span class="w-10 h-1 bg-blue-600 rounded-full"></span>
            <span class="text-blue-600 text-xs font-black tracking-[0.25em] uppercase">Lab Positioning</span>
          </div>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-950 tracking-tight leading-tight">
            Research is only complete when it can be used.
          </h2>
          <p class="mt-6 text-slate-600 leading-relaxed text-base lg:text-lg">
            iCPS Lab approaches AI research as system engineering. We begin with field problems, design intelligent models, and validate whether the final system can support people in real settings.
          </p>
        </div>

        <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-3 gap-4">
          <article class="bg-white rounded-[1.75rem] p-6 border border-slate-200/70 shadow-sm">
            <div class="w-12 h-12 rounded-2xl bg-blue-50 text-blue-700 flex items-center justify-center mb-5 font-black">01</div>
            <h3 class="font-black text-slate-900 text-lg mb-2">Field Sensing</h3>
            <p class="text-slate-500 text-sm leading-relaxed">Capture reliable data from healthcare, manufacturing, and human activity environments.</p>
          </article>
          <article class="bg-white rounded-[1.75rem] p-6 border border-slate-200/70 shadow-sm">
            <div class="w-12 h-12 rounded-2xl bg-cyan-50 text-cyan-700 flex items-center justify-center mb-5 font-black">02</div>
            <h3 class="font-black text-slate-900 text-lg mb-2">AI Reasoning</h3>
            <p class="text-slate-500 text-sm leading-relaxed">Build recognition, assessment, and decision-support models with measurable performance.</p>
          </article>
          <article class="bg-white rounded-[1.75rem] p-6 border border-slate-200/70 shadow-sm">
            <div class="w-12 h-12 rounded-2xl bg-slate-100 text-slate-800 flex items-center justify-center mb-5 font-black">03</div>
            <h3 class="font-black text-slate-900 text-lg mb-2">System Impact</h3>
            <p class="text-slate-500 text-sm leading-relaxed">Deploy prototypes that support training, care, safety, and operational efficiency.</p>
          </article>
        </div>
      </section>

      <section class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-stretch">
        <div class="lg:col-span-5">
          <div class="relative h-full min-h-[420px] rounded-[2.25rem] overflow-hidden bg-slate-900 shadow-2xl group">
            <img src="/images/professor-chang.png" alt="Professor Wan-Jung Chang" class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" onerror="this.src='/images/professor.png';" />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/20 to-transparent"></div>
            <div class="absolute left-6 right-6 bottom-6">
              <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/15 text-white text-[11px] font-bold tracking-widest uppercase backdrop-blur border border-white/20 mb-4">Principal Investigator</div>
              <h2 class="text-white text-3xl font-black">張萬榮 教授</h2>
              <p class="text-blue-200 mt-1 font-medium">Wan-Jung Chang, Ph.D.</p>
            </div>
          </div>
        </div>

        <div class="lg:col-span-7">
          <div class="h-full bg-white border border-slate-200/70 rounded-[2.25rem] p-8 sm:p-10 lg:p-12 shadow-sm">
            <div class="inline-flex items-center gap-3 mb-5">
              <span class="w-9 h-1 bg-blue-600 rounded-full"></span>
              <span class="text-blue-600 text-xs font-black tracking-[0.25em] uppercase">Lab Leadership</span>
            </div>
            <h3 class="text-3xl sm:text-4xl font-black text-slate-950 tracking-tight mb-6">Training engineers who can cross disciplines and solve practical problems.</h3>
            <p class="text-slate-600 leading-relaxed mb-7">
              Led by Professor Wan-Jung Chang, the lab connects electronic engineering, AIoT systems, edge AI, healthcare collaboration, and industrial applications. Students are encouraged to move from theoretical understanding to deployable prototypes.
            </p>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-8">
              <div class="rounded-2xl bg-slate-50 border border-slate-100 p-4">
                <div class="text-slate-900 font-black">AIoT</div>
                <div class="text-xs text-slate-500 mt-1">Intelligent sensing</div>
              </div>
              <div class="rounded-2xl bg-slate-50 border border-slate-100 p-4">
                <div class="text-slate-900 font-black">Edge AI</div>
                <div class="text-xs text-slate-500 mt-1">Real-time deployment</div>
              </div>
              <div class="rounded-2xl bg-slate-50 border border-slate-100 p-4">
                <div class="text-slate-900 font-black">XR</div>
                <div class="text-xs text-slate-500 mt-1">Immersive training</div>
              </div>
            </div>
            <a href="https://ec.nkust.edu.tw/p/404-1122-98302.php?Lang=zh-tw" target="_blank" rel="noopener noreferrer" class="inline-flex justify-center items-center gap-2 bg-slate-900 hover:bg-blue-700 text-white px-5 py-3 rounded-full font-bold text-sm transition hover:-translate-y-0.5">
              Faculty Profile
            </a>
          </div>
        </div>
      </section>

      <section class="bg-white border border-slate-200/70 rounded-[2.25rem] p-8 sm:p-10 lg:p-12 shadow-sm">
        <div class="max-w-3xl mb-10">
          <p class="text-blue-600 text-xs font-black tracking-[0.25em] uppercase mb-4">Research Focus</p>
          <h2 class="text-3xl sm:text-4xl font-black text-slate-950 tracking-tight">Core directions for intelligent cyber-physical systems.</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
          {[
            ["Smart Healthcare", "AI-assisted care, clinical training, rehabilitation, and safety monitoring."],
            ["AIoT Sensing", "Sensor fusion, computer vision, ToF, thermal sensing, and human activity understanding."],
            ["Edge Intelligence", "Deployable AI systems for real-time feedback and low-latency applications."],
            ["Smart Manufacturing", "Industrial inspection, automation, and AI-enabled process improvement."]
          ].map(([heading, copy]) => (
            <article class="rounded-[1.5rem] bg-slate-50 border border-slate-100 p-6">
              <h3 class="font-black text-slate-900 mb-3">{heading}</h3>
              <p class="text-slate-600 text-sm leading-relaxed">{copy}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="bg-gradient-to-r from-slate-900 to-blue-950 rounded-[2.25rem] p-8 sm:p-10 lg:p-12 text-white overflow-hidden relative">
        <div class="absolute top-0 right-0 w-80 h-80 bg-blue-500/20 rounded-full blur-3xl translate-x-1/2 -translate-y-1/2"></div>
        <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          <div class="lg:col-span-8">
            <p class="text-blue-300 text-xs font-black tracking-[0.25em] uppercase mb-4">Collaboration & Talent</p>
            <h2 class="text-3xl sm:text-4xl font-black tracking-tight mb-5">We welcome students and partners who want to build useful AI systems.</h2>
            <p class="text-slate-300 leading-relaxed">
              iCPS Lab works with hospitals, care institutions, industry partners, and academic collaborators. Students can participate in research projects, competitions, publications, and prototype deployment.
            </p>
          </div>
          <div class="lg:col-span-4 flex flex-col gap-3">
            <a href="/members" class="inline-flex justify-center items-center bg-white text-slate-950 px-5 py-3 rounded-full font-bold hover:bg-blue-50 transition">Meet the Team</a>
            <a href="/achievements" class="inline-flex justify-center items-center bg-white/10 text-white border border-white/15 px-5 py-3 rounded-full font-bold hover:bg-white/15 transition">View Achievements</a>
          </div>
        </div>
      </section>
    </div>
  </main>

  <footer class="bg-slate-950 text-slate-300 border-t border-slate-800">
    <div class="max-w-7xl mx-auto px-6 py-10 flex flex-col md:flex-row gap-6 md:items-center md:justify-between">
      <div>
        <p class="text-white font-black text-lg">iCPS Lab</p>
        <p class="text-sm text-slate-400 mt-1">Intelligent Cyber-Physical Systems Lab, NKUST</p>
      </div>
      <div class="flex flex-col sm:flex-row gap-3 text-sm">
        <a href="/about" class="hover:text-white transition">中文版本</a>
        <a href="mailto:allenchang@nkust.edu.tw" class="hover:text-white transition">allenchang@nkust.edu.tw</a>
      </div>
    </div>
  </footer>
</BaseLayout>
