---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Navbar from "../../../components/Navbar.astro";
import { newsData, type NewsItem } from "../../../data/news";

export function getStaticPaths() {
  return newsData.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

const { item } = Astro.props as { item: NewsItem };
const englishNewsTitles: Record<string, string> = {
  "2026-medical-taiwan-ai-surgical-instrument-recognition": "iCPS Lab Showcases AI Surgical Instrument Recognition at Medical Taiwan 2026",
  "2026-international-nursing-summit-indonesia": "Prof. Wan-Jung Chang Joins International Nursing Summit 2026 in Bandung, Indonesia",
  "2026-icme-ai-surgical-instrument-award": "iCPS Lab Receives Excellent Poster Submission Recognition at ICME 2026",
  "2026-itaoi-honorable-mention": "iCPS Lab Receives Honorable Mention at ITAOI 2026",
  "2026-neihu-vocational-school-visit": "Neihu Vocational School Visits iCPS Lab",
  "2026-atlife-expo-ai-care": "AI Care Technologies Showcased at the 2026 ATLife Expo",
  "2026-student-project-competition-second-place": "Student Project Team Wins Second Place in National Competition",
  "2026-ustv-ai-smart-glasses-report": "USTV Features iCPS Lab AI Smart Glasses Research",
  "2026-ustv-ar-glasses-tof-interview": "USTV Interview on AR Glasses and ToF Applications",
  "2026-student-project-competition-finalist": "Student Project Team Selected as National Competition Finalist",
  "2026-japan-patent-tongue-rehabilitation": "Japan Patent Granted for Tongue Rehabilitation Game Platform",
  "2026-icct-pacific-papers": "iCPS Lab Presents Papers at ICCT-Pacific 2026",
  "2026-dsp-competition-celebration": "DSP Competition Celebration",
  "2026-website-launch": "iCPS Lab Website Launch",
  "2026-master-student-recruitment": "Master's Student Recruitment Announcement",
};
const getEnglishNewsTag = (slug: string) => {
  if (slug.includes("medical-taiwan")) return "Exhibition";
  if (slug.includes("nursing-summit")) return "International";
  if (slug.includes("icme") || slug.includes("itaoi")) return "Award";
  if (slug.includes("neihu")) return "Visit";
  if (slug.includes("atlife")) return "Exhibition";
  if (slug.includes("competition") || slug.includes("dsp")) return "Competition";
  if (slug.includes("ustv")) return "Media";
  if (slug.includes("patent")) return "Patent";
  if (slug.includes("icct")) return "Publication";
  return "Announcement";
};
const displayTitle = englishNewsTitles[item.slug] ?? item.title;
const displayTag = getEnglishNewsTag(item.slug);
const title = `${displayTitle} | iCPS Lab`;
const description = `${item.date} - ${displayTitle}`;
const bodyClass = "bg-[#f8fafc] text-slate-800 font-sans antialiased selection:bg-blue-200 selection:text-blue-900";
---

<BaseLayout title={title} description={description} bodyClass={bodyClass} lang="en">
  <Fragment slot="head">
    <style is:global>
      .news-detail-content > div > :first-child {
        margin-top: 0;
      }

      .news-detail-content img {
        border-radius: 1.25rem;
      }
    </style>
  </Fragment>

  <Navbar activePath="/en/news" lang="en" />

  <main class="min-h-screen relative overflow-hidden">
    <section class="relative overflow-hidden bg-slate-950 text-white border-b border-slate-800">
      <div class="absolute inset-0 pointer-events-none">
        <div class="absolute -left-24 top-16 h-72 w-72 rounded-full bg-blue-500/20 blur-3xl"></div>
        <div class="absolute right-[-8rem] bottom-[-8rem] h-96 w-96 rounded-full bg-cyan-500/10 blur-3xl"></div>
      </div>

      <div class="relative max-w-7xl mx-auto px-6 py-12 sm:py-16 lg:py-20">
        <a href="/en/news" class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/10 px-4 py-2 text-sm font-bold text-blue-100 backdrop-blur transition hover:bg-white/15 hover:text-white mb-8">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          Back to News</a>

        <div class="grid lg:grid-cols-12 gap-8 lg:gap-12 items-center">
          <div class="lg:col-span-7">
            <div class="flex flex-wrap items-center gap-3 mb-6">
              <time class="text-blue-200 font-mono text-sm tracking-tight">{item.date}</time>
              <span class={`px-2.5 py-1 text-xs font-bold rounded-sm border bg-white ${item.tagTheme}`}>{displayTag}</span>
              {item.isPinned && (
                <span class="px-2 py-0.5 text-[11px] font-bold text-red-200 bg-red-500/15 border border-red-300/30 rounded">Pinned</span>
              )}
            </div>
            <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight leading-tight">
              {displayTitle}
            </h1>
            <p class="mt-6 text-slate-300 text-base sm:text-lg leading-relaxed max-w-2xl">
              iCPS Lab news and research updates
            </p>
          </div>

          {item.img && (
            <div class="lg:col-span-5">
              <div class="relative overflow-hidden rounded-[2rem] border border-white/15 bg-white/10 p-3 shadow-2xl shadow-blue-950/30 backdrop-blur-xl">
                <img src={item.img} alt={item.imgAlt} class="w-full aspect-[16/10] object-cover rounded-[1.5rem] bg-slate-800" loading="lazy" onerror="this.style.display='none';" />
                {item.imgAlt && (
                  <p class="px-2 pt-3 text-xs leading-relaxed text-slate-300">
                    {item.imgAlt}
                  </p>
                )}
              </div>
            </div>
          )}
        </div>
      </div>
    </section>

    <article class="max-w-7xl mx-auto px-6 py-12 sm:py-16">
      <div class="grid lg:grid-cols-12 gap-8 lg:gap-10">
        <aside class="lg:col-span-3">
          <div class="lg:sticky lg:top-28 rounded-[1.5rem] bg-white border border-slate-200/80 p-6 shadow-sm">
            <p class="text-xs font-black tracking-[0.18em] text-blue-700 uppercase mb-4">News Detail</p>
            <dl class="space-y-4 text-sm">
              <div>
                <dt class="text-slate-400 font-bold mb-1">Date</dt>
                <dd class="text-slate-800 font-mono">{item.date}</dd>
              </div>
              <div>
                <dt class="text-slate-400 font-bold mb-1">Category</dt>
                <dd>
                  <span class={`inline-flex px-2.5 py-1 text-xs font-medium rounded-sm border ${item.tagTheme}`}>{displayTag}</span>
                </dd>
              </div>
            </dl>
            <a href="/en/news" class="mt-6 inline-flex w-full items-center justify-center gap-2 rounded-full bg-slate-950 px-4 py-3 text-sm font-bold text-white transition hover:bg-blue-700">
              Back to News List
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
              </svg>
            </a>
          </div>
        </aside>

        <section class="lg:col-span-9">
          <div class="news-detail-content rounded-[2rem] bg-white border border-slate-200/80 shadow-sm p-6 sm:p-8 lg:p-10 text-slate-700 text-base leading-relaxed space-y-5">
            {!item.img && (
              <div class="mb-8 rounded-[1.5rem] bg-slate-50 border border-slate-200 p-6">
                <p class="text-sm font-bold text-slate-500">iCPS Lab News</p>
                <p class="mt-2 text-slate-700">{displayTitle}</p>
              </div>
            )}
            <div set:html={item.content}></div>
          </div>
        </section>
      </div>
    </article>
  </main>

  <footer class="bg-[#0f172a] py-16 mt-auto border-t border-slate-800 relative z-20">
    <div class="max-w-7xl mx-auto px-6 flex flex-col md:flex-row justify-between items-start gap-10">
      <div class="md:w-1/2">
        <img src="/images/footer-logo.png" alt="iCPS Lab" class="h-14 md:h-20 w-auto mb-3 object-contain" onerror="this.style.display='none';" />
        <p class="text-sm text-blue-400 font-medium mb-4">Intelligent Cyber-Physical Systems Laboratory</p>
        <p class="text-sm text-slate-400 leading-relaxed max-w-md">
          Intelligent Cyber-Physical Systems Laboratory <br/>
          National Kaohsiung University of Science and Technology (NKUST)
        </p>
      </div>
      <div class="md:w-1/2 flex flex-col md:items-end text-sm space-y-3">
        <h3 class="text-white font-semibold mb-2 tracking-wide uppercase text-xs">Contact Us</h3>
        <p class="flex items-center gap-2 text-slate-300"><span class="text-slate-500">Location</span> National Kaohsiung University of Science and Technology, Jiangong Campus</p>
        <p class="flex items-center gap-2 text-slate-300"><span class="text-slate-500">Tel</span> 07-3814526 ext. 15672</p>
        <p class="flex items-center gap-2 text-slate-300"><span class="text-slate-500">Email</span> <a href="mailto:allenchang@nkust.edu.tw" class="hover:text-blue-400 transition">allenchang@nkust.edu.tw</a></p>
      </div>
    </div>
    <div class="max-w-7xl mx-auto px-6 mt-12 pt-6 border-t border-slate-800 flex flex-col lg:flex-row justify-between items-center gap-6 lg:gap-4">
      <div class="flex flex-col sm:flex-row items-center gap-2 sm:gap-4 text-center sm:text-left">
        <p class="text-xs text-slate-500 leading-normal">
          &copy; 2026 <span class="italic font-['Times_New_Roman',_Times,_serif] text-[1.15em]">i</span>CPS Lab, National Kaohsiung University of Science and Technology.
        </p>
        <p class="text-xs text-slate-500 hidden sm:block">|</p>
        <p class="text-xs text-slate-500">All rights reserved.</p>
      </div>
      <div class="flex items-center gap-2 bg-slate-800/50 px-3 py-1.5 rounded-md border border-slate-700 shadow-sm transition hover:border-slate-600">
        <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
        </svg>
        <span class="text-xs text-slate-400 font-medium tracking-wide">Total visits</span>
        <span class="text-xs text-slate-600 mx-1">|</span>
        <span class="text-sm font-mono font-bold text-blue-400 tracking-wider" id="visitor-count">Loading...</span>
      </div>
    </div>
  </footer>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const initCounter = async () => {
        const counterEl = document.getElementById('visitor-count');
        if (!counterEl) return;
        const namespace = 'icpslab_site', key = 'visits';
        const localCountKey = 'icps_saved_count', lastVisitTimeKey = 'icps_last_visit_time';
        const TWENTY_FOUR_HOURS = 24 * 60 * 60 * 1000;
        let currentCount = localStorage.getItem(localCountKey) || '------';
        const lastVisitTime = localStorage.getItem(lastVisitTimeKey);
        const now = Date.now();
        const hasVisitedWithin24Hours = lastVisitTime && (now - parseInt(lastVisitTime, 10) < TWENTY_FOUR_HOURS);
        try {
          const url = `https://api.counterapi.dev/v1/${namespace}/${key}`;
          if (!hasVisitedWithin24Hours) {
            const response = await fetch(url + '/up');
            if (!response.ok) throw new Error('API error');
            const data = await response.json();
            currentCount = String(data.count).padStart(6, '0');
            localStorage.setItem(lastVisitTimeKey, now.toString());
            localStorage.setItem(localCountKey, currentCount);
          } else {
            try {
              const r = await fetch(url);
              if (r.ok) {
                const d = await r.json();
                currentCount = String(d.count).padStart(6, '0');
                localStorage.setItem(localCountKey, currentCount);
              }
            } catch {}
          }
        } catch {}
        counterEl.textContent = currentCount;
      };
      initCounter();
    });
  </script>
</BaseLayout>
