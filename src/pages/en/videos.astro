---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Footer from "../../components/Footer.astro";
import Navbar from "../../components/Navbar.astro";
import PageHero from "../../components/PageHero.astro";
import Videos from "../../components/Videos.astro";

const pageHeroItems = [
  { label: "REPORTS", value: "Media Reports", note: "News coverage, exhibition exposure, and interviews" },
  { label: "DEMOS", value: "Research Demos", note: "AI systems, student projects, and technical showcases" },
  { label: "STORIES", value: "Lab Records", note: "Events, exchanges, and field moments" },
];

const title = "Media | iCPS Lab";
const description = "Featured videos and media from iCPS Lab research, projects, exhibitions, and interviews.";
const bodyClass = "bg-[#f8fafc] text-slate-800 font-sans antialiased selection:bg-blue-200 selection:text-blue-900";
---

<BaseLayout title={title} description={description} bodyClass={bodyClass} lang="en">
  <Navbar activePath="/en/videos" lang="en" />

  <main class="min-h-screen">
    <PageHero
      badgeDetail="Media & Videos"
      eyebrow="MEDIA LIBRARY"
      title="Media"
      description="Featured videos, media reports, research demos, exhibition highlights, and interviews from iCPS Lab."
      primaryLabel="Watch Videos"
      primaryHref="#main-content"
      secondaryLabel="Research demos and media reports"
      panelLabel="MEDIA INDEX"
      panelTitle="Section Guide"
      panelItems={pageHeroItems}
    />

    <section id="main-content" class="max-w-7xl mx-auto px-6 py-12 sm:py-16">
      <div class="rounded-[2rem] bg-white/85 backdrop-blur-xl border border-white shadow-[0_18px_60px_rgba(15,23,42,0.07)] p-4 sm:p-6 lg:p-8 overflow-hidden">
        <Videos lang="en" />
      </div>
    </section>
  </main>

  <Footer lang="en" margin="auto" phone="07-3814526 ext. 15672" />


</BaseLayout>
