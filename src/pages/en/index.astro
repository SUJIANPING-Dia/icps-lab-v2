---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/Navbar.astro";

const title = "iCPS Lab | Intelligent Cyber-Physical Systems Lab";
const description = "English overview of iCPS Lab at NKUST, focusing on AIoT, edge AI, smart healthcare, and deployable cyber-physical systems.";
const bodyClass = "bg-[#f8fafc] text-slate-800 font-sans antialiased selection:bg-blue-200 selection:text-blue-900 relative flex flex-col min-h-screen overflow-x-hidden";
---

<BaseLayout title={title} description={description} bodyClass={bodyClass} lang="en">
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700;900&family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  </Fragment>

  <Navbar activePath="/en" lang="en" />

  <main class="flex-grow">
    <section class="relative overflow-hidden bg-slate-950 text-white">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_20%_20%,rgba(37,99,235,0.35),transparent_32%),radial-gradient(circle_at_85%_15%,rgba(14,165,233,0.2),transparent_34%),linear-gradient(135deg,#020617_0%,#0f172a_56%,#071327_100%)]"></div>
      <div class="absolute inset-0 bg-[linear-gradient(rgba(255,255,255,0.035)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.035)_1px,transparent_1px)] bg-[size:56px_56px] opacity-30"></div>
      <div class="relative z-10 max-w-7xl mx-auto px-6 py-20 lg:py-28">
        <p class="text-blue-300 font-black tracking-[0.28em] uppercase text-xs sm:text-sm mb-5">Intelligent Cyber-Physical Systems Lab</p>
        <div class="max-w-4xl">
          <h1 class="text-4xl sm:text-5xl lg:text-7xl font-black tracking-tight leading-[1.05]">
            AIoT research for systems that can be tested, deployed, and improved.
          </h1>
          <p class="mt-7 text-slate-300 text-base sm:text-lg leading-relaxed max-w-3xl">
            iCPS Lab at National Kaohsiung University of Science and Technology builds AI-enabled cyber-physical systems for smart healthcare, sensing, edge intelligence, and real-world field applications.
          </p>
        </div>
        <div class="mt-10 flex flex-col sm:flex-row gap-3">
          <a href="/en/about" class="inline-flex justify-center items-center bg-blue-600 hover:bg-blue-500 text-white font-bold px-6 py-3 rounded-full shadow-lg shadow-blue-950/30 transition">About the Lab</a>
          <a href="/en/members" class="inline-flex justify-center items-center bg-white/10 hover:bg-white/15 text-white font-bold px-6 py-3 rounded-full border border-white/15 backdrop-blur transition">Meet the Team</a>
        </div>
      </div>
    </section>

    <section class="max-w-7xl mx-auto px-6 py-16 lg:py-24 space-y-16">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start">
        <div class="lg:col-span-5">
          <p class="text-blue-600 text-xs font-black tracking-[0.25em] uppercase mb-4">Research Focus</p>
          <h2 class="text-3xl sm:text-4xl font-black text-slate-950 tracking-tight">From sensing to AI decisions to field deployment.</h2>
          <p class="mt-5 text-slate-600 leading-relaxed">
            The English site is being expanded step by step. Formal project names, paper titles, and personal names may remain in their original language when accuracy matters.
          </p>
        </div>
        <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-4">
          {[
            ["Smart Healthcare", "AI-assisted clinical training, care safety, rehabilitation, and medical education systems."],
            ["AIoT Sensing", "Computer vision, ToF, thermal sensing, embedded data collection, and sensor fusion."],
            ["Edge Intelligence", "Deployable AI systems that support real-time feedback outside the lab."],
            ["Smart Manufacturing", "Inspection, automation, and intelligent systems for industrial environments."]
          ].map(([heading, copy]) => (
            <article class="bg-white rounded-[1.5rem] p-6 border border-slate-200/70 shadow-sm">
              <h3 class="text-slate-950 font-black text-xl mb-3">{heading}</h3>
              <p class="text-slate-600 text-sm leading-relaxed">{copy}</p>
            </article>
          ))}
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <a href="/en/about" class="group bg-white rounded-[1.5rem] p-6 border border-slate-200/70 shadow-sm hover:shadow-xl transition">
          <p class="text-blue-600 text-xs font-black tracking-[0.2em] uppercase mb-3">01</p>
          <h3 class="text-slate-950 font-black text-xl mb-2 group-hover:text-blue-700">About</h3>
          <p class="text-slate-600 text-sm leading-relaxed">Understand the lab mission, leadership, and research positioning.</p>
        </a>
        <a href="/en/members" class="group bg-white rounded-[1.5rem] p-6 border border-slate-200/70 shadow-sm hover:shadow-xl transition">
          <p class="text-blue-600 text-xs font-black tracking-[0.2em] uppercase mb-3">02</p>
          <h3 class="text-slate-950 font-black text-xl mb-2 group-hover:text-blue-700">Members</h3>
          <p class="text-slate-600 text-sm leading-relaxed">Browse the lab team structure while preserving names in their original form.</p>
        </a>
        <a href="/en/faq" class="group bg-white rounded-[1.5rem] p-6 border border-slate-200/70 shadow-sm hover:shadow-xl transition">
          <p class="text-blue-600 text-xs font-black tracking-[0.2em] uppercase mb-3">03</p>
          <h3 class="text-slate-950 font-black text-xl mb-2 group-hover:text-blue-700">FAQ</h3>
          <p class="text-slate-600 text-sm leading-relaxed">Read a concise English guide for prospective students and collaborators.</p>
        </a>
      </div>
    </section>
  </main>
</BaseLayout>
