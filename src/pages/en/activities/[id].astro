---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Navbar from "../../../components/Navbar.astro";

// 🔷 第一步：動態生成所有相簿頁面的路徑
export async function getStaticPaths() {
  const cloudName = import.meta.env.CLOUDINARY_CLOUD_NAME;
  const apiKey = import.meta.env.CLOUDINARY_API_KEY;
  const apiSecret = import.meta.env.CLOUDINARY_API_SECRET;

  try {
    const response = await fetch(`https://api.cloudinary.com/v1_1/${cloudName}/folders/events`, {
      headers: {
        'Authorization': `Basic ${btoa(apiKey + ':' + apiSecret)}`
      }
    });
    
    const result = await response.json();
    
    if (result.folders && result.folders.length > 0) {
      return result.folders.map(folder => ({
        params: { id: folder.name }
      }));
    }
    
    return [];
  } catch (error) {
    console.error("生成相簿路徑失敗:", error);
    return [];
  }
}

// 🔷 第二步：根據目前的 ID 抓取該相簿內的所有照片
const { id } = Astro.params; 
let photos = [];

try {
  const cloudName = import.meta.env.CLOUDINARY_CLOUD_NAME;
  const apiKey = import.meta.env.CLOUDINARY_API_KEY;
  const apiSecret = import.meta.env.CLOUDINARY_API_SECRET;

  const response = await fetch(`https://api.cloudinary.com/v1_1/${cloudName}/resources/search`, {
    method: 'POST',
    headers: {
      'Authorization': `Basic ${btoa(apiKey + ':' + apiSecret)}`,
      'Content-Type': 'application/json'
    },
    body: JSON.stringify({
      expression: `folder="events/${id}"`, 
      sort_by: [{ created_at: 'desc' }],
      max_results: 500
    })
  });

  const result = await response.json();
  if (result.resources) {
    // 這裡我們產生兩種 URL：一個是列表用的縮圖 (thumb)，一個是放大用的原圖 (full)
    photos = result.resources.map(img => ({
      thumb: img.secure_url.replace('/upload/', '/upload/f_auto,q_auto,w_800/'),
      full: img.secure_url.replace('/upload/', '/upload/f_auto,q_auto/')
    }));
  }
} catch (error) {
  console.error("讀取相簿照片失敗:", error);
}

const title = `${id} - Activity Album | iCPS Lab`;
const description = `Browse photos and records from the iCPS Lab activity album: ${id}.`;
const bodyClass = "bg-[#f8fafc] text-slate-800 font-sans antialiased selection:bg-blue-200 selection:text-blue-900 relative";
---

<BaseLayout title={title} description={description} bodyClass={bodyClass} lang="en">
  <Fragment slot="head">
    <style is:global>
    /* 🔷 放大燈箱的 CSS 樣式 */
    #lightbox-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background-color: rgba(0, 0, 0, 0.9);
      z-index: 9999;
      cursor: zoom-out;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }

    #lightbox-image {
      max-width: 100%;
      max-height: 100%;
      border-radius: 4px;
      box-shadow: 0 0 40px rgba(0, 0, 0, 0.5);
      transform: scale(0.9);
      transition: transform 0.3s ease-out;
      cursor: default;
    }

    #lightbox-overlay.active #lightbox-image {
      transform: scale(1);
    }
    
    /* 禁止滾動的輔助樣式 */
    .no-scroll {
      overflow: hidden !important;
    }
    </style>
  </Fragment>

  <!-- 🔷 頂部導覽列 (Navbar) -->
  <Navbar activePath="/en/activities" lang="en" />

  <!-- 🔷 頁面標題區 -->
<style>
    /* 專屬於頂部 Banner 的載入動畫 (若您已經把這段加到 global.css 裡面，這段 <style> 就可以刪除) */
    @keyframes heroZoom {
      from { opacity: 0; transform: scale(0.95); }
      to { opacity: 1; transform: scale(1); }
    }
    .animate-hero-zoom {
      animation: heroZoom 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
  </style>

  <header class="bg-gradient-to-r from-slate-900 via-[#0f172a] to-slate-800 py-16 lg:py-20 text-center border-b-[5px] border-blue-700 relative overflow-hidden shadow-inner">
    <div class="absolute inset-0 opacity-20 bg-[url('https://www.transparenttextures.com/patterns/cubes.png')] pointer-events-none"></div>
    
    <div class="relative z-10 px-4 animate-hero-zoom">
      <h1 class="text-3xl md:text-5xl font-extrabold text-white tracking-widest mb-4 drop-shadow-md">{id}</h1>
      <p class="text-blue-200 text-sm md:text-base font-medium tracking-[0.2em] uppercase drop-shadow">Album Details</p>
    </div>
  </header>

  <!-- 🔷 網站主體區域 -->
  <main class="max-w-7xl mx-auto px-6 py-16 relative z-20 min-h-screen">
    <div class="mb-10">
      <a href="/en/activities" class="inline-flex items-center text-sm font-bold text-slate-500 hover:text-blue-700 transition">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
        Back to Activity Albums
      </a>
    </div>

    <!-- 📷 網格顯示所有照片 (加上點擊放大的標記) -->
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 md:gap-6">
      {photos.length > 0 ? (
        photos.map((img) => (
          <div class="aspect-[4/3] rounded-md overflow-hidden shadow-sm border border-slate-200 bg-white group cursor-zoom-in gallery-item">
            <img 
              src={img.thumb} 
              data-full={img.full}
              alt="Activity photo"
              class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500 gallery-img" 
              loading="lazy" 
            />
          </div>
        ))
      ) : (
        <div class="col-span-full text-center py-20">
          <p class="text-slate-500 text-lg">This album currently has no photos, or photos are still loading...</p>
        </div>
      )}
    </div>
  </main>

  <!-- 🔷 燈箱元件 (Lightbox Overlay) -->
  <div id="lightbox-overlay" aria-hidden="true">
    <img id="lightbox-image" src="" alt="Enlarged activity photo" />
  </div>

  <!-- 🔷 頁尾 (Footer) -->
  <footer class="bg-[#0f172a] py-16 mt-auto border-t border-slate-800 relative z-20">
    <div class="max-w-7xl mx-auto px-6 flex flex-col md:flex-row justify-between items-start gap-10">
      <div class="md:w-1/2">
        <img src="/images/footer-logo.png" alt="iCPS Lab" class="h-14 md:h-20 w-auto mb-3 object-contain" onerror="this.style.display='none';" />
        <p class="text-sm text-blue-400 font-medium mb-4">Intelligent Cyber-Physical Systems Laboratory</p>
        <p class="text-sm text-slate-400 leading-relaxed max-w-md">
          Intelligent Cyber-Physical Systems Laboratory <br/>
          National Kaohsiung University of Science and Technology (NKUST)
        </p>
      </div>
      <div class="md:w-1/2 flex flex-col md:items-end text-sm space-y-3">
        <h3 class="text-white font-semibold mb-2 tracking-wide uppercase text-xs">Contact Us</h3>
        <p class="flex items-center gap-2 text-slate-300"><span class="text-slate-500">Location</span> National Kaohsiung University of Science and Technology, Jiangong Campus</p>
        <p class="flex items-center gap-2 text-slate-300"><span class="text-slate-500">Tel</span> 07-3814526 ext. 15672</p>
        <p class="flex items-center gap-2 text-slate-300"><span class="text-slate-500">Email</span> <a href="mailto:allenchang@nkust.edu.tw" class="hover:text-blue-400 transition">allenchang@nkust.edu.tw</a></p>
      </div>
    </div>
    <div class="max-w-7xl mx-auto px-6 mt-12 pt-6 border-t border-slate-800 flex flex-col lg:flex-row justify-between items-center gap-6 lg:gap-4">
      <div class="flex flex-col sm:flex-row items-center gap-2 sm:gap-4 text-center sm:text-left">
        <p class="text-xs text-slate-500 leading-normal">
          &copy; 2026 <span class="italic font-['Times_New_Roman',_Times,_serif] text-[1.15em]">i</span>CPS Lab, National Kaohsiung University of Science and Technology.
        </p>
        <p class="text-xs text-slate-500 hidden sm:block">|</p>
        <p class="text-xs text-slate-500">All rights reserved.</p>
      </div>
      <div class="flex items-center gap-2 bg-slate-800/50 px-3 py-1.5 rounded-md border border-slate-700 shadow-sm transition hover:border-slate-600">
        <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
        </svg>
        <span class="text-xs text-slate-400 font-medium tracking-wide">Total visits</span>
        <span class="text-xs text-slate-600 mx-1">|</span>
        <span class="text-sm font-mono font-bold text-blue-400 tracking-wider" id="visitor-count">Loading...</span>
      </div>
    </div>
  </footer>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      // --- 1. 燈箱放大邏輯 (保留原樣) ---
      const overlay = document.getElementById('lightbox-overlay');
      const lightboxImg = document.getElementById('lightbox-image');
      const galleryImgs = document.querySelectorAll('.gallery-img');

      if (overlay && lightboxImg) {
        galleryImgs.forEach(img => {
          img.addEventListener('click', () => {
            const fullUrl = img.getAttribute('data-full');
            if (fullUrl) {
              lightboxImg.src = fullUrl;
              overlay.style.display = 'flex';
              setTimeout(() => overlay.classList.add('active'), 10);
              document.body.classList.add('no-scroll');
            }
          });
        });

        overlay.addEventListener('click', () => {
          overlay.classList.remove('active');
          setTimeout(() => {
            overlay.style.display = 'none';
            lightboxImg.src = '';
          }, 300);
          document.body.classList.remove('no-scroll');
        });
      }

      // --- 2. 訪客計數器邏輯 (保留原樣) ---
      const initCounter = async () => {
        const counterEl = document.getElementById('visitor-count');
        if (!counterEl) return;
        const url = `https://api.counterapi.dev/v1/icpslab_site/visits`;
        try {
          const response = await fetch(url + '/up');
          const data = await response.json();
          counterEl.textContent = String(data.count).padStart(6, '0');
        } catch (e) {
          counterEl.textContent = '000000';
        }
      };
      initCounter();
    });
  </script>
</BaseLayout>
