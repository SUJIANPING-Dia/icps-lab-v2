  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const tabBtns=Array.from(document.querySelectorAll('.faq-tab-btn')),categoryGroups=Array.from(document.querySelectorAll('.faq-category-group')),searchInput=document.getElementById('faq-search-input'),clearSearchBtn=document.getElementById('clear-search'),searchResetInline=document.getElementById('search-reset-inline'),noResultsMsg=document.getElementById('no-results-msg'),sidebar=document.getElementById('faq-sidebar'),searchState=document.getElementById('search-state'),searchCount=document.getElementById('search-count'),searchKeyword=document.getElementById('search-keyword');let currentActiveTabTarget='category-0';
      const closeAllInGroup=(group)=>{group.querySelectorAll('.faq-item.is-open').forEach(item=>{item.classList.remove('is-open');const btn=item.querySelector('.faq-btn');if(btn)btn.setAttribute('aria-expanded','false')})};const switchTab=(targetId)=>{currentActiveTabTarget=targetId;tabBtns.forEach(btn=>btn.classList.toggle('is-active',btn.getAttribute('data-target')===targetId));categoryGroups.forEach(group=>{group.classList.toggle('is-active',group.id===targetId);if(group.id!==targetId)closeAllInGroup(group)})};
      tabBtns.forEach(btn=>btn.addEventListener('click',()=>{if(searchInput&&searchInput.value.trim()!=='')resetSearch(false);switchTab(btn.getAttribute('data-target'));window.scrollTo({top:document.querySelector('main').offsetTop-20,behavior:'smooth'})}));document.querySelectorAll('.faq-btn').forEach(btn=>btn.addEventListener('click',()=>{const item=btn.closest('.faq-item'),group=btn.closest('.faq-category-group'),willOpen=!item.classList.contains('is-open');if(group)closeAllInGroup(group);item.classList.toggle('is-open',willOpen);btn.setAttribute('aria-expanded',willOpen?'true':'false')}));
      document.querySelectorAll('.open-all-btn').forEach(btn=>btn.addEventListener('click',()=>{const group=document.getElementById(btn.getAttribute('data-group'));if(!group)return;const items=Array.from(group.querySelectorAll('.faq-item:not(.hidden)'));const shouldOpen=items.some(item=>!item.classList.contains('is-open'));items.forEach(item=>{item.classList.toggle('is-open',shouldOpen);const faqBtn=item.querySelector('.faq-btn');if(faqBtn)faqBtn.setAttribute('aria-expanded',shouldOpen?'true':'false')});btn.childNodes[0].textContent=shouldOpen?'Collapse This Category':'Expand This Category'}));
      const performSearch=(term)=>{const searchTerm=term.toLowerCase().trim();let resultCount=0;if(searchTerm===''){resetSearch(false);return}clearSearchBtn.classList.remove('hidden');searchState.classList.remove('hidden');sidebar.classList.add('opacity-60');noResultsMsg.classList.add('hidden');searchKeyword.textContent=searchTerm;categoryGroups.forEach(group=>{let hasResultInGroup=false;group.querySelectorAll('.faq-item').forEach(item=>{const q=item.getAttribute('data-question')||'',a=item.getAttribute('data-answer')||'',matched=q.includes(searchTerm)||a.includes(searchTerm);item.classList.toggle('hidden',!matched);item.classList.remove('is-open');const btn=item.querySelector('.faq-btn');if(btn)btn.setAttribute('aria-expanded','false');if(matched){hasResultInGroup=true;resultCount+=1}});group.classList.toggle('is-active',hasResultInGroup)});searchCount.textContent=String(resultCount);noResultsMsg.classList.toggle('hidden',resultCount!==0)};
      function resetSearch(keepFocus=true){if(searchInput)searchInput.value='';clearSearchBtn.classList.add('hidden');searchState.classList.add('hidden');noResultsMsg.classList.add('hidden');sidebar.classList.remove('opacity-60');document.querySelectorAll('.faq-item').forEach(item=>{item.classList.remove('hidden','is-open');const btn=item.querySelector('.faq-btn');if(btn)btn.setAttribute('aria-expanded','false')});switchTab(currentActiveTabTarget);if(keepFocus&&searchInput)searchInput.focus()}if(searchInput)searchInput.addEventListener('input',e=>performSearch(e.target.value));if(clearSearchBtn)clearSearchBtn.addEventListener('click',()=>resetSearch(true));if(searchResetInline)searchResetInline.addEventListener('click',()=>resetSearch(true));
      const revealObs=new IntersectionObserver((entries,obs)=>{entries.forEach(entry=>{if(entry.isIntersecting){entry.target.classList.add('is-visible');obs.unobserve(entry.target)}})},{threshold:.12,rootMargin:'0px 0px -50px 0px'});document.querySelectorAll('[data-reveal]').forEach(el=>revealObs.observe(el));
      const initCounter=async()=>{const counterEl=document.getElementById('visitor-count');if(!counterEl)return;const namespace='icpslab_site',key='visits',localCountKey='icps_saved_count',lastVisitTimeKey='icps_last_visit_time',TTL=86400000;let currentCount=localStorage.getItem(localCountKey)||'000000';const lastVisitTime=localStorage.getItem(lastVisitTimeKey),now=Date.now(),visited=lastVisitTime&&(now-parseInt(lastVisitTime,10)<TTL);try{const url='https://api.counterapi.dev/v1/'+namespace+'/'+key;const response=await fetch(visited?url:url+'/up');if(!response.ok)throw new Error('API Error');const data=await response.json();currentCount=String(data.count).padStart(6,'0');if(!visited)localStorage.setItem(lastVisitTimeKey,now.toString());localStorage.setItem(localCountKey,currentCount)}catch(error){}counterEl.textContent=currentCount};initCounter();
    });
  </script>
