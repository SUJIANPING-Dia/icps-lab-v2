---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/Navbar.astro";
import PageHero from "../../components/PageHero.astro";

// ==========================================
// 🔹 Q&A 資料區 
// 加入了 section 屬性來區分「學生」與「合作夥伴」
// ==========================================
const faqs = [
  {
    section: "Students and Admissions",
    category: "About the Lab",
    items: [
      { question: "What are the main research areas and core technologies of iCPS Lab?", answer: "iCPS Lab, the Intelligent Cyber-Physical Systems Laboratory, focuses on artificial intelligence, healthcare AI, and smart manufacturing. We integrate IoT, edge computing, and deep learning technologies, and apply research outcomes in real clinical and industrial settings to solve real-world problems." },
      { question: "Who leads the lab, and what research directions does the lab emphasize?", answer: "The lab is led by Professor Wan-Jung Chang. His expertise aligns closely with the lab's development, covering AIoT, Medical IoT, and Industrial IoT. The lab values not only algorithm research, but also hardware-software integration and practical deployment." },
      { question: "What is Professor Chang's advising style? Is communication difficult?", answer: "Professor Chang's advising style balances direction-setting and hands-on implementation. He provides clear research directions and strong resources while giving students flexibility to explore. He values practical ability and deployable outcomes, and is open to discussion." },
      { question: "What is the lab atmosphere like? How do senior and junior students interact?", answer: "The lab atmosphere is focused but not oppressive. We value teamwork and knowledge transfer. Senior and junior students support one another technically and solve problems together, creating a collaborative and warm learning environment." },
      { question: "Where is the lab located?", answer: "The lab is located on the 8th floor of the Information Industry Building at the NKUST Jianguo Campus." }
    ]
  },
  {
    category: "Admissions and Joining",
    items: [
      { question: "Is the lab currently recruiting new students?", answer: "Yes. We welcome motivated doctoral students, master's students, and undergraduate project students. We also welcome international students and aim to provide an international research environment." },
      { question: "Can I join if I do not have a background in AI or IoT?", answer: "Yes. We care more about your willingness to learn and your initiative. If you have basic programming logic, the lab can provide training and support from senior students to help you steadily enter the field." },
      { question: "Which programming languages should I know before joining?", answer: "Python is the main language for AI development in the lab. Familiarity with Python helps, and C/C++ or other languages are also useful, especially for IoT and edge-device development. These are not strict requirements as long as you are willing to learn." },
      { question: "Do I need to learn machine learning before meeting the professor?", answer: "No. You do not need to be an AI expert before joining. We can guide you from basic algorithm concepts to hands-on implementation. What matters most is being willing to face challenges and solve problems." }
    ]
  },
  {
    category: "Undergraduate Projects",
    items: [
      { question: "What can undergraduate project students work on in the lab?", answer: "Project students can work with frontier technologies such as AI visual recognition, healthcare AI system development, and IoT edge-device implementation. We strongly encourage students to turn research ideas into demonstrable prototype systems, which can strengthen graduate-school applications and job interviews." },
      { question: "Are project topics assigned by the professor, or can students propose their own topics?", answer: "Both are possible. If you do not have a clear direction yet, the professor and senior students can provide potential topics. If you already have an idea, you are welcome to discuss it with the professor, and we can help turn it into a feasible and meaningful project." },
      { question: "Will undergraduate projects be too difficult? What if I cannot complete one?", answer: "The difficulty is adjusted based on each student's background. The goal is to help you grow within a reasonable challenge level. If you get stuck, senior students will support you, so you will not be left alone." },
      { question: "Will project work take too much time and affect regular coursework?", answer: "We follow the principle that coursework comes first. With proper time management and steady progress, most students can balance academic courses and project work. Exam periods can be handled with flexible scheduling." },
      { question: "I have never done a project before. Will I fall behind?", answer: "No need to worry. We value learning attitude more than starting point. The lab has beginner training and senior-student support, so even students starting from zero can gradually build confidence and skills." },
      { question: "What level of outcome can an undergraduate project reach?", answer: "We encourage projects to go beyond reports and become demonstrable prototype systems. These may include complete functions, user interfaces, and application scenarios, giving your work practical value." },
      { question: "Can project outcomes help with graduate applications or job hunting?", answer: "Yes. A complete project system, GitHub portfolio, and demo presentation can be strong evidence in graduate-school applications and job interviews." },
      { question: "Are undergraduate projects complete systems or just reports?", answer: "Our projects are system-implementation oriented. Instead of only writing reports, students work through data processing, model design, and front-end/back-end integration to build systems that truly run." },
      { question: "Is there a chance to join competitions or publish work?", answer: "Yes. We encourage and support students to join competitions or academic presentations when project outcomes are strong enough, helping students build experience and resume highlights." },
      { question: "Will someone guide me during the project, or do I need to figure everything out alone?", answer: "You will not be left on your own. In addition to the professor's guidance, senior students provide technical support and share experience so you can avoid many unnecessary detours." },
      { question: "Are projects individual or team-based?", answer: "Projects are usually team-based, similar to real industry development. You will learn not only programming, but also task division, system integration, and problem solving with teammates." },
      { question: "How much time should I spend on a project each week?", answer: "It depends on the project stage, but around 6 to 12 hours per week is usually enough for steady progress. The key is consistent accumulation rather than short bursts of intense work." },
      { question: "Can I balance a part-time job with a project?", answer: "Yes, if you plan your time well. Most students can balance coursework, project work, and part-time jobs, and the lab can provide flexible arrangements when needed." },
      { question: "Will I have access to real hospital or enterprise data?", answer: "There may be opportunities through industry-academia collaboration, such as medical images or production-line data, making projects closer to real applications." },
      { question: "Can a project develop into a product or startup idea?", answer: "Potentially yes. We encourage students to deepen projects into applicable systems. If a project has commercial value, it may be extended toward productization or entrepreneurship." },
      { question: "What if the project does not work out?", answer: "We provide ongoing technical support and direction adjustment during the process. The goal is not instant success, but learning how to solve problems step by step." },
      { question: "Will a project include full system development or only model training?", answer: "It includes more than models. We emphasize the full pipeline from AI models to system integration, including data processing, training, deployment, and application demos." }
    ]
  },
  {
    category: "Master's Students",
    items: [
      { question: "Are graduation requirements difficult? Must master's students publish papers?", answer: "We strongly encourage students to submit strong research outcomes to domestic or international conferences and journals, which is valuable for future careers. The professor also adjusts expectations according to each student's career goals, such as entering industry or continuing to doctoral study." },
      { question: "How long does it usually take master's students to graduate?", answer: "Most students who maintain normal research progress and report regularly in meetings can graduate within the standard period of about two years. The lab does not intentionally hold students back." },
      { question: "Does the lab require fixed core hours or clock-in rules?", answer: "The lab uses a responsibility-based and flexible-time approach. There is no strict clock-in requirement. We value research progress and output quality more than the number of hours spent at a desk." },
      { question: "If I changed fields or have weak programming skills, will coding pressure be overwhelming?", answer: "There will be a technical adjustment period because this is a hands-on lab. However, the lab has accumulated codebases and learning resources, and senior students and the professor provide code reviews and guidance. If you face the challenge directly, you can get through it." },
      { question: "Does the professor micro-manage students?", answer: "The professor's style is based on trust and empowerment. He provides key guidance and direction, and adjusts the level of follow-up based on each student's self-discipline. Students are given room to develop independently." },
      { question: "How many research topics or projects do master's students usually join?", answer: "It depends on progress and ability, but most students focus on one or two major research or industry-academia projects. We encourage doing one topic deeply rather than spreading effort across too many projects." },
      { question: "Do master's students need to define their own topics, or will the professor provide topics?", answer: "Both are possible. The professor provides promising research directions and topics, and students with their own ideas are also welcome to discuss them. We help adjust ideas into feasible and meaningful research topics." },
      { question: "How often do students usually meet with the professor?", answer: "Meetings are usually weekly or biweekly, adjusted according to research progress. Regular discussion helps keep the direction correct and the work moving forward." },
      { question: "Do master's students collaborate with each other or work separately?", answer: "In many cases there is collaboration and exchange. Different projects often share technologies and resources, and students may cooperate in system development or project tasks." },
      { question: "Does the lab provide salary, scholarships, or financial support?", answer: "Yes. The lab has a flexible scholarship system based on student ability and performance. Students who are willing to contribute and show outcomes can usually receive appropriate support." },
      { question: "Can master's students join industry-academia projects?", answer: "Yes. The lab collaborates with companies and hospitals, giving master's students opportunities to work on practical projects, real needs, and field data." },
      { question: "Can master's students attend international conferences?", answer: "Yes. When research outcomes reach a suitable level, the lab encourages submissions to international conferences and provides related resources and funding support." },
      { question: "Where do graduates usually go after leaving the lab?", answer: "Many graduates enter the technology industry, including semiconductor, AI, and startup companies, as software, algorithm, or system engineers. Some students continue to doctoral study." },
      { question: "Does the lab support students who want to pursue a PhD?", answer: "Yes. The professor helps students plan research directions, publications, and application strategies, and provides recommendations and resources for doctoral applications." },
      { question: "What are the lab's advantages compared with other labs?", answer: "The lab has a complete research support system, including senior students, postdoctoral researchers, and direct professor guidance. Dedicated staff also handle administrative work so students can focus on research and quickly build practical skills." }
    ]
  },
  {
    category: "PhD Students",
    items: [
      { question: "Do PhD students have freedom in choosing research topics?", answer: "Yes. PhD students are treated as independent researchers with high autonomy. The professor discusses advanced technologies with students as a collaborator and supports each student in developing a distinctive research direction and long-term academic plan." },
      { question: "Does the lab support PhD students in international academic publication?", answer: "Yes, strongly. For high-quality international journals and flagship conferences, the lab provides academic resources and funding support to help PhD students reach the international stage." },
      { question: "Are there opportunities for international collaboration or exchange?", answer: "Yes. Depending on current projects and research topics, PhD students may collaborate with overseas universities or multinational companies, and may pursue short-term international exchange opportunities." },
      { question: "How many papers are required for PhD graduation?", answer: "Students must meet the doctoral program's publication-point requirements at NKUST. The lab does not add unnecessary extra restrictions and helps students plan publications according to research progress and quality." },
      { question: "What levels of journals or conferences does the lab usually target?", answer: "The lab mainly targets international journals and academic conferences in AI, healthcare AI, and smart manufacturing, and encourages students to challenge influential journals and representative conferences." },
      { question: "Does the lab have experience submitting to high-level international journals?", answer: "Yes. The lab has accumulated publications in international journals and conferences, including influential journals and high-quality venues, and has experience with submission and review responses." },
      { question: "Can PhD students be first authors?", answer: "Yes. PhD students usually lead their research and have opportunities to serve as first authors, taking responsibility for the core research and writing." },
      { question: "Is there guidance for paper writing?", answer: "Yes. The professor and team provide guidance on paper structure, writing, and submission strategy to improve paper quality and acceptance potential." },
      { question: "Is scholarship or funding support available for PhD students?", answer: "Yes. Full-time PhD students may receive scholarships or related funding support so they can focus on research and academic development." },
      { question: "Can PhD students attend international conferences abroad?", answer: "Yes. When research outcomes meet submission standards, the lab encourages international conference participation and provides related funding support to broaden international exposure." },
      { question: "Are postdoctoral researchers or research teams available to support PhD students?", answer: "Yes. The lab has postdoctoral researchers and a complete research team that provide technical support, experience transfer, and a research discussion environment." },
      { question: "What are common career paths after PhD graduation?", answer: "Graduates can enter academia, research institutions, or industry positions in AI, semiconductors, and system development, with strong potential and competitiveness." }
    ]
  },
  {
    category: "Industry-Academia and Career Development",
    items: [
      { question: "Does the lab have industry-academia projects? Can students work with industry?", answer: "Yes. This is one of our strongest advantages. The lab connects with many hospitals and well-known companies. Students do not only work on simulated data; they participate in real industry projects and develop systems that can be used in practice." },
      { question: "Can students access real-world data during research?", answer: "Yes. Through industry-academia collaboration, students may access valuable real-world data such as clinical images or production-line sensing data, making their research closely connected to industry needs." },
      { question: "How are career prospects after graduating from iCPS Lab?", answer: "Career prospects are strong. Many graduates enter leading technology companies, system companies, semiconductor-related industries, or AI startups as algorithm, software, or firmware engineers. Some students continue doctoral study in Taiwan or abroad." }
    ]
  },
  {
    category: "Technologies and Learning",
    items: [
      { question: "What core technologies will I learn and use in the lab?", answer: "The technical stack is broad and practical, including Python and C/C++ development, PyTorch, computer vision such as YOLO and image processing, IoT sensing data collection, Edge AI deployment, and front-end/back-end system integration." },
      { question: "Does the lab provide training for beginners?", answer: "Yes. We have a mature onboarding system that includes teaching documents passed down from previous students, hands-on practice tasks, and one-on-one mentoring from senior students." },
      { question: "Can a complete programming beginner survive in the lab?", answer: "Yes, if you have determination to solve problems and courage to make mistakes. Many strong students started from zero. The key is being willing to practice, ask questions, and learn actively." }
    ]
  },
  {
    category: "Facilities and Resources",
    items: [
      { question: "Are the lab's hardware and computing resources sufficient?", answer: "Yes. To support AI computation, the lab has high-end GPU servers equipped with RTX 3090 and 4090 cards. For edge devices, students can use NVIDIA Jetson devices, ToF depth sensors, thermal cameras, and various IoT modules for implementation and testing." },
      { question: "Is funding available for international conferences or paper presentations?", answer: "Yes. When your paper is accepted by a quality conference or journal, the lab and university usually provide support such as registration, travel, and accommodation subsidies to encourage international exposure." }
    ]
  },
  {
    category: "Other Common Questions",
    items: [
      { question: "Engineering labs are often said to be exhausting. Is that true here?", answer: "Project deadlines or paper submission periods can be busy, but we strongly oppose ineffective long overtime. If you work efficiently and maintain progress, you can still keep a healthy balance." },
      { question: "Can students graduate on time? Will the lab intentionally delay graduation?", answer: "The lab does not intentionally hold students back. If you complete the professor's required progress and graduation requirements, most students can graduate on time." },
      { question: "Can I change research direction after joining?", answer: "Yes. The lab is flexible. If you discover another topic that better fits your interests after initial exploration, you can discuss it with the professor, who will evaluate feasibility and help you transition smoothly." },
      { question: "Does the lab hold gatherings or activities outside research?", answer: "Yes. The lab occasionally holds midterm or end-of-semester meals, welcome and farewell gatherings, and sports or social activities, balancing research with team connection and well-being." },
      { question: "Will joining the lab be very stressful?", answer: "There will be challenges, but the lab provides team support and senior-student help. The goal is to help you grow within a manageable level of pressure." },
      { question: "Is the lab atmosphere serious or competitive?", answer: "No. The overall atmosphere is relaxed and collaboration-oriented. Members help one another, solve problems together, and also participate in social activities." },
      { question: "Do students need to stay in the lab for long hours?", answer: "No. We use flexible time management and value outcomes rather than seat time. Graduate students do have their own desks for research and discussion." },
      { question: "Will I be alone if I have questions?", answer: "No. The lab has senior students, postdoctoral researchers, and team support. Members are encouraged to discuss and help one another." },
      { question: "Do I need strong math or programming skills from the beginning?", answer: "No. We value learning attitude and problem-solving ability. If you are willing to learn, the lab provides resources and guidance to help you grow." },
      { question: "Will I only be helping the professor with research?", answer: "No. We value student participation and growth. You will take part in system development and problem solving, building abilities and experience that belong to you." },
      { question: "Are the skills learned here useful in industry?", answer: "Yes. We emphasize hands-on implementation and system integration, including AI models, system development, and real applications, all of which are highly demanded in industry." },
      { question: "What kind of person is this lab suitable for?", answer: "It is suitable for people who are willing to learn, take initiative, solve problems, and are interested in technology. If you want real technical growth and practical experience, this lab can be a good fit." },
      { question: "Who might not be a good fit for this lab?", answer: "Students who are unwilling to invest time in learning or who prefer to wait passively for assigned tasks may not be a good fit. We value initiative and willingness to grow." },
      { question: "Is the lab suitable if I only want to graduate smoothly?", answer: "It is possible, but not strongly recommended because you may miss many growth opportunities. The lab is best suited for students who want to build technical ability and practical experience." },
      { question: "Is this lab suitable if I really want to learn technology?", answer: "Very suitable. We emphasize hands-on system development, allowing students to build from fundamentals toward practical capability for future careers or advanced research." }
    ]
  },
  {
    section: "Industry and Collaboration",
    category: "Industry-Academia Collaboration and External Services",
    items: [
      { question: "Does iCPS Lab provide collaboration for companies or hospitals?", answer: "Yes. We have long-term collaborations with hospitals and companies in healthcare AI, AI image recognition, smart manufacturing, and IoT system integration, helping research outcomes reach real-world deployment." },
      { question: "What types of AI systems can the lab help develop?", answer: "We can help develop applications such as image recognition, defect detection, medical image analysis, behavior recognition, sensing data analytics, smart monitoring systems, and AI edge-computing deployment." },
      { question: "Does the lab have actual hospital or industry collaboration experience?", answer: "Yes. We have collaborated with multiple medical institutions and companies on clinical assistance systems, smart monitoring systems, and AI detection applications for manufacturing, with complete practical experience." },
      { question: "What collaboration models are common?", answer: "Common models include industry-academia projects, commissioned technology development, system validation testing, and joint applications for government programs such as NSTC or industry-academia funding." },
      { question: "Can the lab handle real field data such as medical or production-line data?", answer: "Yes. We have experience handling real field data and value privacy and security. For medical applications, we can work with IRB processes for research and development." },
      { question: "Does collaboration require a high technical threshold from the partner?", answer: "No. Collaboration can start from problem discussion and requirement analysis. We can help evaluate feasibility and propose suitable technical approaches." },
      { question: "Can the lab conduct PoC or prototype development?", answer: "Yes. We are experienced in building prototype systems and proof-of-concept validation from zero to one, helping partners quickly evaluate technical feasibility and business value." },
      { question: "Does the lab provide technology transfer or deployment services?", answer: "Yes. Our goal is not research alone, but practical deployment, including system deployment, model optimization, and application integration." },
      { question: "What value can collaboration bring?", answer: "Partners can gain AI technology adoption, process optimization, cost reduction, and efficiency improvement, while also strengthening technical competitiveness and innovation through industry-academia collaboration." },
      { question: "How can potential partners contact the lab?", answer: "You are welcome to use the website contact information or contact the professor and lab directly. We can arrange further requirement discussions and collaboration planning." }
    ]
  }
];

const totalFaqItems = faqs.reduce((sum, group) => sum + group.items.length, 0);
const cooperationIndex = faqs.findIndex(group => group.section === "Industry and Collaboration");
const studentFaqItems = faqs.filter((_, index) => cooperationIndex === -1 || index < cooperationIndex).reduce((sum, group) => sum + group.items.length, 0);
const partnerFaqItems = faqs.filter((_, index) => cooperationIndex !== -1 && index >= cooperationIndex).reduce((sum, group) => sum + group.items.length, 0);
const pageHeroItems = [
  { label: "QUESTIONS", value: `${totalFaqItems} FAQs`, note: "Joining, projects, research, and collaboration" },
  { label: "CATEGORIES", value: `${faqs.length} categories`, note: "Browse questions by topic" },
  { label: "AUDIENCE", value: "Students & Partners", note: "Information for lab applicants and collaborators" },
];

const title = "FAQ | iCPS Lab";
const description = "Frequently asked questions about joining iCPS Lab, student research, graduate training, lab resources, and collaboration.";
const bodyClass = "bg-[#f8fafc] text-slate-800 font-sans antialiased selection:bg-blue-200 selection:text-blue-900 relative";
---

<BaseLayout title={title} description={description} bodyClass={bodyClass} lang="en">
  <Fragment slot="head">
    <style is:global>
    .hide-scrollbar::-webkit-scrollbar{display:none}.hide-scrollbar{-ms-overflow-style:none;scrollbar-width:none}
    [data-reveal]{opacity:0;transition:opacity .75s cubic-bezier(.22,1,.36,1),transform .75s cubic-bezier(.22,1,.36,1)}
    [data-reveal="up"]{transform:translateY(28px)}[data-reveal="left"]{transform:translateX(-28px)}[data-reveal="zoom"]{transform:scale(.97)}[data-reveal].is-visible{opacity:1;transform:translate(0,0) scale(1)}
    .faq-category-group{display:none}.faq-category-group.is-active{display:block;animation:faqPanelIn .38s cubic-bezier(.22,1,.36,1) both}@keyframes faqPanelIn{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}
    .faq-answer-content{max-height:0;overflow:hidden;opacity:0;transition:max-height .35s cubic-bezier(.22,1,.36,1),opacity .25s ease}.faq-item.is-open .faq-answer-content{max-height:580px;opacity:1}.faq-item.is-open .faq-icon{transform:rotate(45deg)}.faq-item.is-open{border-color:#bfdbfe;box-shadow:0 18px 45px -32px rgba(37,99,235,.55)}
    .faq-tab-btn.is-active{background:linear-gradient(135deg,#1d4ed8,#0f172a);color:#fff;border-color:transparent;box-shadow:0 16px 35px -22px rgba(37,99,235,.8)}.faq-tab-btn.is-active .tab-count{background:rgba(255,255,255,.16);color:#fff}.faq-tab-btn.is-active .tab-dot{background:#93c5fd}
    </style>
  </Fragment>

  <!-- 🔷 頂部導覽列 (Navbar) -->
  <Navbar activePath="/en/faq" lang="en" />

  <PageHero
    badgeDetail="FAQ Center"
    eyebrow="QUESTIONS & ANSWERS"
    title="FAQ"
    description="Frequently asked questions about joining iCPS Lab, student projects, graduate training, lab resources, and collaboration opportunities."
    primaryLabel="Search Questions"
    primaryHref="#faq-search"
    secondaryLabel="For students and partners"
    panelLabel="FAQ INDEX"
    panelTitle="Section Guide"
    panelItems={pageHeroItems}
  />

  <section id="faq-search" class="relative z-20 bg-slate-950 border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-6 py-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 items-center">
        <div class="lg:col-span-8 relative group">
          <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none"><svg class="h-5 w-5 text-blue-200 group-focus-within:text-blue-600 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg></div><input type="text" id="faq-search-input" class="block w-full pl-12 pr-11 py-4 bg-white text-slate-900 placeholder-slate-400 border border-white/20 rounded-2xl focus:outline-none focus:ring-4 focus:ring-blue-500/25 focus:border-blue-300 transition-all duration-300 shadow-lg" placeholder="Search joining, projects, research, collaboration, resources..." /><button id="clear-search" class="absolute inset-y-0 right-0 pr-4 flex items-center hidden text-slate-400 hover:text-slate-700" aria-label="Clear search"><svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg></button>
        </div>
        <div class="lg:col-span-4 grid grid-cols-3 gap-3">
          <div class="rounded-2xl bg-white/10 border border-white/10 p-4 text-white"><div class="text-2xl font-black tabular-nums">{totalFaqItems}</div><div class="text-[10px] tracking-widest uppercase text-blue-100 mt-1">Questions</div></div><div class="rounded-2xl bg-white/10 border border-white/10 p-4 text-white"><div class="text-2xl font-black tabular-nums">{faqs.length}</div><div class="text-[10px] tracking-widest uppercase text-blue-100 mt-1">Categories</div></div><div class="rounded-2xl bg-white/10 border border-white/10 p-4 text-white"><div class="text-2xl font-black tabular-nums">2</div><div class="text-[10px] tracking-widest uppercase text-blue-100 mt-1">Audiences</div></div>
        </div>
      </div>
    </div>
  </section>

  <main id="main-content" class="relative z-20"><div class="absolute inset-x-0 top-0 h-72 bg-gradient-to-b from-blue-50/80 to-transparent pointer-events-none"></div><div class="relative max-w-7xl mx-auto px-6 py-12 lg:py-16 min-h-[55vh]"><div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10">
    <aside class="lg:col-span-4 xl:col-span-3" id="faq-sidebar" data-reveal="left"><div class="lg:sticky lg:top-8 space-y-4"><div class="bg-white/90 backdrop-blur rounded-[1.5rem] border border-slate-200 shadow-sm p-4"><div class="flex items-center justify-between mb-4 px-1"><div><h2 class="text-sm font-black text-slate-900 tracking-wide">Question Categories</h2><p class="text-xs text-slate-500 mt-1">Choose a topic to browse the FAQ</p></div><span class="text-xs font-bold text-blue-700 bg-blue-50 border border-blue-100 px-2 py-1 rounded-full">{faqs.length}</span></div><div class="flex lg:flex-col overflow-x-auto lg:overflow-visible hide-scrollbar gap-2 pb-1 lg:pb-0" id="faq-tabs-container">
      {faqs.map((faqGroup, index) => (<>{faqGroup.section && (<div class={`${index !== 0 ? 'lg:mt-5' : ''} hidden lg:flex items-center gap-2 px-2 py-2`}><span class="text-xs font-black text-slate-400 tracking-widest uppercase">{faqGroup.section}</span></div>)}<button class={`faq-tab-btn ${index === 0 ? 'is-active' : ''} flex-shrink-0 lg:w-full min-w-[190px] lg:min-w-0 text-left px-4 py-3 rounded-2xl text-sm font-bold transition-all duration-250 border border-slate-200 bg-white text-slate-700 hover:bg-blue-50 hover:border-blue-200 hover:text-blue-800`} data-target={`category-${index}`}><div class="flex items-center gap-3"><span class="tab-dot w-2 h-2 rounded-full bg-slate-300 shrink-0"></span><span class="flex-1 truncate">{faqGroup.category}</span><span class="tab-count inline-flex items-center justify-center bg-slate-100 text-slate-500 rounded-full min-w-6 h-6 px-2 text-xs">{faqGroup.items.length}</span></div></button></>))}
    </div></div><div class="hidden lg:block rounded-[1.5rem] bg-slate-900 text-white p-5 overflow-hidden relative"><div class="absolute -right-8 -top-8 w-28 h-28 rounded-full bg-blue-500/20 blur-2xl"></div><div class="relative"><div class="text-xs font-black text-blue-200 tracking-widest uppercase mb-2">Need more help?</div><p class="text-sm text-slate-300 leading-relaxed mb-4">If you cannot find the answer you need, please contact the lab directly.</p><a href="mailto:allenchang@nkust.edu.tw" class="inline-flex items-center gap-2 text-sm font-bold bg-white text-slate-900 hover:bg-blue-50 px-4 py-2.5 rounded-xl transition">Contact Us<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg></a></div></div></div></aside>

    <section class="lg:col-span-8 xl:col-span-9" id="faq-content-area" data-reveal="up" style="transition-delay:120ms;"><div id="search-state" class="hidden mb-6 rounded-[1.5rem] border border-blue-100 bg-blue-50 px-5 py-4 text-sm text-blue-900"><div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3"><div>Search results: <span id="search-count" class="font-black">0</span> matches for "<span id="search-keyword" class="font-black"></span>"</div><button id="search-reset-inline" class="text-blue-700 font-bold hover:text-blue-900 text-left sm:text-right">Clear Search</button></div></div><div id="no-results-msg" class="hidden text-center py-16 px-6 bg-white rounded-[1.5rem] border border-dashed border-slate-300 shadow-sm"><h3 class="text-xl font-black text-slate-800 mb-2">No matching questions found</h3><p class="text-slate-500 text-sm sm:text-base leading-relaxed">Please try another keyword or contact us directly.</p></div><div id="faq-groups-container">
      {faqs.map((faqGroup, groupIndex) => (<div id={`category-${groupIndex}`} class={`faq-category-group ${groupIndex === 0 ? 'is-active' : ''}`}><div class="mb-6"><div class="inline-flex items-center gap-3 mb-3"><span class="w-9 h-1 bg-blue-600 rounded-full"></span><span class="text-blue-700 text-xs font-black tracking-widest uppercase">FAQ Category</span></div><div class="flex flex-col md:flex-row md:items-end justify-between gap-3"><div><h2 class="text-2xl md:text-3xl font-black text-slate-900 tracking-tight">{faqGroup.category}</h2><p class="text-sm text-slate-500 mt-2">{faqGroup.items.length} frequently asked questions</p></div><button class="open-all-btn inline-flex items-center gap-2 text-sm font-bold text-blue-700 bg-white border border-blue-100 hover:bg-blue-50 px-4 py-2.5 rounded-full transition shadow-sm" data-group={`category-${groupIndex}`}>Expand This Category<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg></button></div></div><div class="space-y-3">{faqGroup.items.map((item, itemIndex) => {const uniqueId = `faq-${groupIndex}-${itemIndex}`;return (<div class="faq-item bg-white border border-slate-200 rounded-[1.25rem] overflow-hidden shadow-sm transition-all duration-300" data-question={item.question.toLowerCase()} data-answer={item.answer.toLowerCase()}><button class="faq-btn w-full px-5 py-4 sm:px-6 sm:py-5 text-left flex justify-between gap-5 items-start focus:outline-none group hover:bg-slate-50 transition" aria-expanded="false" aria-controls={uniqueId}><div class="flex items-start gap-4 min-w-0"><span class="hidden sm:inline-flex w-8 h-8 rounded-xl bg-blue-50 text-blue-700 items-center justify-center text-xs font-black shrink-0 mt-[-2px]">Q</span><span class="font-black text-slate-800 text-[15px] sm:text-base group-hover:text-blue-700 transition leading-relaxed faq-question-text">{item.question}</span></div><span class="faq-icon w-9 h-9 rounded-full bg-slate-100 text-slate-500 group-hover:bg-blue-600 group-hover:text-white transition-all duration-300 shrink-0 flex items-center justify-center"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg></span></button><div id={uniqueId} class="faq-answer-content bg-gradient-to-b from-slate-50 to-white border-t border-slate-100"><div class="px-5 py-5 sm:px-6 sm:py-6 text-slate-600 text-sm sm:text-[15px] leading-loose faq-answer-text flex gap-4"><span class="hidden sm:inline-flex w-8 h-8 rounded-xl bg-slate-900 text-white items-center justify-center text-xs font-black shrink-0">A</span><span>{item.answer}</span></div></div></div>);})}</div></div>))}
    </div></section>
  </div></div></main>

  <!-- 🔷 頁尾 (Footer) -->
  <footer class="bg-[#0f172a] py-16 mt-12 border-t border-slate-800 relative z-20">
    <div class="max-w-7xl mx-auto px-6 flex flex-col md:flex-row justify-between items-start gap-10">
      <div class="md:w-1/2">
        <img src="/images/footer-logo.webp" alt="iCPS Lab" class="h-14 md:h-20 w-auto mb-3 object-contain" onerror="this.style.display='none';" />
        <p class="text-sm text-blue-400 font-medium mb-4">Intelligent Cyber-Physical Systems Laboratory</p>
