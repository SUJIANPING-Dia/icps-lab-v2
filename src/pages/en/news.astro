---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import PageHero from "../../components/PageHero.astro";
import News from "../../components/News.astro";

const title = "News | iCPS Lab";
const description = "Latest iCPS Lab news, research updates, awards, visits, media coverage, and announcements.";
const bodyClass = "bg-[#f8fafc] text-slate-800 font-sans antialiased selection:bg-blue-200 selection:text-blue-900";
const newsHeroItems = [
  { label: "AI Research", value: "Research Updates", note: "Smart healthcare, AIoT, edge AI, and clinical field applications" },
  { label: "Recognition", value: "Awards", note: "Student projects, paper awards, patents, and cross-domain collaborations" },
  { label: "Outreach", value: "Events & Media", note: "Exhibitions, media coverage, international exchange, and lab announcements" },
];
---

<BaseLayout title={title} description={description} bodyClass={bodyClass} lang="en">
  <Navbar activePath="/en/news" lang="en" />

  <main class="min-h-screen">
    <PageHero
      eyebrow="News & Announcements"
      title="News"
      description="Follow iCPS Lab updates across smart healthcare, AIoT, edge intelligence, and cross-domain research, including publications, awards, events, and media coverage."
      primaryLabel="Browse News"
      primaryHref="#news"
      secondaryLabel="AI-enabled research updates"
      panelLabel="Signal Index"
      panelTitle="Section Guide"
      panelItems={newsHeroItems}
    />

    <section id="main-content" class="max-w-7xl mx-auto px-6 py-12 sm:py-16">
      <News lang="en" />
    </section>
  </main>

  <Footer lang="en" margin="auto" campus="National Kaohsiung University of Science and Technology, Jiangong Campus" phone="07-3814526 ext. 15672" />
</BaseLayout>
