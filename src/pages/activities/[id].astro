---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";

// 🔷 第一步：動態生成所有相簿頁面的路徑
export async function getStaticPaths() {
  const cloudName = import.meta.env.CLOUDINARY_CLOUD_NAME;
  const apiKey = import.meta.env.CLOUDINARY_API_KEY;
  const apiSecret = import.meta.env.CLOUDINARY_API_SECRET;

  try {
    const response = await fetch(`https://api.cloudinary.com/v1_1/${cloudName}/folders/events`, {
      headers: {
        'Authorization': `Basic ${btoa(apiKey + ':' + apiSecret)}`
      }
    });
    
    const result = await response.json();
    
    if (result.folders && result.folders.length > 0) {
      return result.folders.map(folder => ({
        params: { id: folder.name }
      }));
    }
    
    return [];
  } catch (error) {
    console.error("生成相簿路徑失敗:", error);
    return [];
  }
}

// 🔷 第二步：根據目前的 ID 抓取該相簿內的所有照片
const { id } = Astro.params; 
let photos = [];

try {
  const cloudName = import.meta.env.CLOUDINARY_CLOUD_NAME;
  const apiKey = import.meta.env.CLOUDINARY_API_KEY;
  const apiSecret = import.meta.env.CLOUDINARY_API_SECRET;

  const response = await fetch(`https://api.cloudinary.com/v1_1/${cloudName}/resources/search`, {
    method: 'POST',
    headers: {
      'Authorization': `Basic ${btoa(apiKey + ':' + apiSecret)}`,
      'Content-Type': 'application/json'
    },
    body: JSON.stringify({
      expression: `folder="events/${id}"`, 
      sort_by: [{ created_at: 'desc' }],
      max_results: 500
    })
  });

  const result = await response.json();
  if (result.resources) {
    // 這裡我們產生兩種 URL：一個是列表用的縮圖 (thumb)，一個是放大用的原圖 (full)
    photos = result.resources.map(img => ({
      thumb: img.secure_url.replace('/upload/', '/upload/f_auto,q_auto,w_800/'),
      full: img.secure_url.replace('/upload/', '/upload/f_auto,q_auto/')
    }));
  }
} catch (error) {
  console.error("讀取相簿照片失敗:", error);
}

const title = `${id} - 活動照片 | iCPS Lab 智慧網宇實體系統實驗室`;
const description = `瀏覽 iCPS Lab「${id}」活動相簿照片與活動紀錄。`;
const bodyClass = "bg-[#f8fafc] text-slate-800 font-sans antialiased selection:bg-blue-200 selection:text-blue-900 relative";
---

<BaseLayout title={title} description={description} bodyClass={bodyClass}>
  <Fragment slot="head">
    <style is:global>
    /* Native dialog keeps background content outside the keyboard focus order. */
    #lightbox-overlay {
      position: fixed;
      inset: 0;
      width: 100vw;
      height: 100dvh;
      max-width: none;
      max-height: none;
      margin: 0;
      border: 0;
      background: transparent;
      cursor: zoom-out;
      padding: 64px 20px 20px;
    }

    #lightbox-overlay[open] {
      display: flex;
      align-items: center;
      justify-content: center;
    }

    #lightbox-overlay::backdrop {
      background: rgba(0, 0, 0, 0.9);
    }

    #lightbox-image {
      max-width: 100%;
      max-height: 100%;
      border-radius: 4px;
      box-shadow: 0 0 40px rgba(0, 0, 0, 0.5);
      object-fit: contain;
      cursor: default;
    }
    
    /* 禁止滾動的輔助樣式 */
    .no-scroll {
      overflow: hidden !important;
    }
    </style>
  </Fragment>

  <!-- 🔷 頂部導覽列 (Navbar) -->
  <Navbar activePath="/activities" />

  <!-- 🔷 頁面標題區 -->
<style>
    /* 專屬於頂部 Banner 的載入動畫 (若您已經把這段加到 global.css 裡面，這段 <style> 就可以刪除) */
    @keyframes heroZoom {
      from { opacity: 0; transform: scale(0.95); }
      to { opacity: 1; transform: scale(1); }
    }
    .animate-hero-zoom {
      animation: heroZoom 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
  </style>

  <header class="bg-gradient-to-r from-slate-900 via-[#0f172a] to-slate-800 py-16 lg:py-20 text-center border-b-[5px] border-blue-700 relative overflow-hidden shadow-inner">
    <div class="absolute inset-0 opacity-20 bg-[url('https://www.transparenttextures.com/patterns/cubes.png')] pointer-events-none"></div>
    
    <div class="relative z-10 px-4 animate-hero-zoom">
      <h1 class="text-3xl md:text-5xl font-extrabold text-white tracking-widest mb-4 drop-shadow-md">{id}</h1>
      <p class="text-blue-200 text-sm md:text-base font-medium tracking-[0.2em] uppercase drop-shadow">Album Details</p>
    </div>
  </header>

  <!-- 🔷 網站主體區域 -->
  <main class="max-w-7xl mx-auto px-6 py-16 relative z-20 min-h-screen">
    <div class="mb-10">
      <a href="/activities" class="inline-flex items-center text-sm font-bold text-slate-500 hover:text-blue-700 transition">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
        返回活動花絮清單
      </a>
    </div>

    <!-- 📷 網格顯示所有照片 (加上點擊放大的標記) -->
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 md:gap-6">
      {photos.length > 0 ? (
        photos.map((img, index) => (
          <button
            type="button"
            class="aspect-[4/3] rounded-md overflow-hidden shadow-sm border border-slate-200 bg-white group cursor-zoom-in gallery-item"
            data-full={img.full}
            data-photo-alt={`${id} 活動照片 ${index + 1}`}
            aria-label={`放大 ${id} 活動照片 ${index + 1}`}
            aria-haspopup="dialog"
            aria-controls="lightbox-overlay"
          >
            <img 
              src={img.thumb} 
              alt={`${id} 活動照片 ${index + 1}`}
              class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500 gallery-img" 
              loading="lazy"
              decoding="async"
            />
          </button>
        ))
      ) : (
        <div class="col-span-full text-center py-20">
          <p class="text-slate-500 text-lg">此相簿目前沒有照片，或是正在載入中...</p>
        </div>
      )}
    </div>
  </main>

  <!-- 🔷 燈箱元件 (Lightbox Overlay) -->
  <dialog id="lightbox-overlay" aria-labelledby="lightbox-title">
    <h2 id="lightbox-title" class="sr-only">{id} 相簿照片</h2>
    <button id="lightbox-close" type="button" class="absolute top-4 right-4 rounded-lg border border-white/60 bg-slate-900 px-4 py-2 font-semibold text-white hover:bg-slate-700 cursor-pointer" autofocus>關閉照片 ×</button>
    <img id="lightbox-image" alt="放大照片" decoding="async" />
  </dialog>

  <!-- 共用頁尾包含經驗證的造訪計數器。 -->
  <Footer lang="zh" />

  <script>
    const overlay = document.querySelector<HTMLDialogElement>("#lightbox-overlay");
    const lightboxImg = document.querySelector<HTMLImageElement>("#lightbox-image");
    const closeButton = document.querySelector<HTMLButtonElement>("#lightbox-close");
    let opener: HTMLButtonElement | null = null;

    if (overlay && lightboxImg && closeButton) {
      document.querySelectorAll<HTMLButtonElement>(".gallery-item").forEach((button) => {
        button.addEventListener("click", () => {
          const fullUrl = button.dataset.full;
          if (!fullUrl || overlay.open) return;
          opener = button;
          lightboxImg.src = fullUrl;
          lightboxImg.alt = button.dataset.photoAlt ?? "相簿照片";
          overlay.showModal();
          document.body.classList.add("no-scroll");
          closeButton.focus();
        });
      });

      closeButton.addEventListener("click", () => overlay.close());
      overlay.addEventListener("keydown", (event) => {
        if (event.key !== "Tab" || !overlay.open) return;
        // Close is the dialog's only focusable control, in either Tab direction.
        event.preventDefault();
        closeButton.focus();
      });
      overlay.addEventListener("click", (event) => {
        if (event.target === overlay) overlay.close();
      });
      // The native cancel action continues to handle Escape.
      overlay.addEventListener("close", () => {
        document.body.classList.remove("no-scroll");
        lightboxImg.removeAttribute("src");
        opener?.focus({ preventScroll: true });
        opener = null;
      });
    }
  </script>
</BaseLayout>
