---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import PageHero from "../components/PageHero.astro";
import News from "../components/News.astro";

const title = "最新消息 | iCPS Lab";
const description = "查看 iCPS Lab 最新消息、研究成果、活動紀錄、競賽與媒體報導。";
const bodyClass = "bg-[#f8fafc] text-slate-800 font-sans antialiased selection:bg-blue-200 selection:text-blue-900";
const newsHeroItems = [
  { label: "AI Research", value: "研究發表", note: "智慧照護、AIoT、邊緣 AI 與臨床場域應用" },
  { label: "Recognition", value: "競賽成果", note: "學生專題、論文獎項、專利與跨域合作成果" },
  { label: "Outreach", value: "活動紀錄", note: "展覽、媒體報導、國際交流與實驗室公告" },
];
---

<BaseLayout title={title} description={description} bodyClass={bodyClass}>
  <Navbar activePath="/news" />

  <main class="min-h-screen">
    <PageHero
      eyebrow="News & Announcements"
      title="最新消息"
      description="追蹤 iCPS Lab 在智慧醫療、AIoT、邊緣運算與跨域研究上的最新成果，快速掌握研究發表、競賽榮譽、活動紀錄與媒體曝光。"
      primaryLabel="瀏覽消息"
      primaryHref="#news"
      secondaryLabel="AI-enabled research updates"
      panelLabel="Signal Index"
      panelTitle="內容索引"
      panelItems={newsHeroItems}
    />

    <section id="main-content" class="max-w-7xl mx-auto px-6 py-12 sm:py-16">
      <News />
    </section>
  </main>

  <Footer lang="zh" margin="auto" />
</BaseLayout>
