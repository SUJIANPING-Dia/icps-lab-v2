---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer.astro";
import Navbar from "../components/Navbar.astro";
import PageHero from "../components/PageHero.astro";
import Videos from "../components/Videos.astro";

const pageHeroItems = [
  { label: "REPORTS", value: "媒體報導", note: "新聞採訪、展覽曝光與外部報導" },
  { label: "DEMOS", value: "研究展示", note: "AI 系統、專題作品與技術展示" },
  { label: "STORIES", value: "活動紀錄", note: "實驗室參與活動與交流片段" },
];

const title = "影音專區 | iCPS Lab";
const description = "觀看 iCPS Lab 研究展示、媒體報導與實驗室相關影片。";
const bodyClass = "bg-[#f8fafc] text-slate-800 font-sans antialiased selection:bg-blue-200 selection:text-blue-900";
---

<BaseLayout title={title} description={description} bodyClass={bodyClass}>
  <Navbar activePath="/videos" />

  <main class="min-h-screen">
    <PageHero
      badgeDetail="Media & Videos"
      eyebrow="MEDIA LIBRARY"
      title="影音專區"
      description="彙整 iCPS Lab 的研究展示、媒體報導與實驗室相關影片內容，讓訪客快速看見研究成果與現場紀錄。"
      primaryLabel="觀看影片"
      primaryHref="#main-content"
      secondaryLabel="Research demos and media reports"
      panelLabel="MEDIA INDEX"
      panelTitle="內容索引"
      panelItems={pageHeroItems}
    />

    <section id="main-content" class="max-w-7xl mx-auto px-6 py-12 sm:py-16">
      <div class="rounded-[2rem] bg-white/85 backdrop-blur-xl border border-white shadow-[0_18px_60px_rgba(15,23,42,0.07)] p-4 sm:p-6 lg:p-8 overflow-hidden">
        <Videos />
      </div>
    </section>
  </main>

  <Footer margin="auto" />


</BaseLayout>
