---
import { newsData, englishNewsTitles, getEnglishNewsTag, sortNews, prepareNewsContent, type NewsItem } from "../data/news";

interface Props {
  lang?: "zh" | "en";
  sectionId?: string;
}

const { lang = "zh", sectionId = "news" } = Astro.props;
const isEnglish = lang === "en";
const newsBasePath = isEnglish ? "/en/news" : "/news";
const sectionTitle = isEnglish ? "News" : "最新消息";
const sectionSubtitle = "News & Announcements";
const pinnedLabel = isEnglish ? "Pinned" : "置頂";
const readMoreLabel = isEnglish ? "Read Full Article" : "閱讀完整新聞";
const getDisplayTitle = (slug: string, fallback: string) => isEnglish ? (englishNewsTitles[slug] ?? fallback) : fallback;
const getDisplayTag = (slug: string, fallback: string) => isEnglish ? getEnglishNewsTag(slug) : fallback;
const getDisplayContent = (item: NewsItem) => isEnglish && item.contentEn ? item.contentEn : item.content;
const getDisplayImgAlt = (item: NewsItem) => isEnglish && item.imgAltEn ? item.imgAltEn : item.imgAlt;
const hasEmbeddedLeadImage = (item: NewsItem, content: string) => Boolean(item.img && content.includes(item.img));
const getPreparedContent = (item: NewsItem) => prepareNewsContent(getDisplayContent(item), lang, getDisplayTitle(item.slug, item.title));

const sortedNewsData = sortNews(newsData);
---

<section id={sectionId} data-news-root class="scroll-mt-12">
  <div class="border-b-2 border-slate-800 pb-3 mb-8 flex justify-between items-end">
    <h2 class="text-3xl font-bold text-slate-900 flex items-center gap-3">
      <div class="w-2 h-8 bg-blue-700"></div>
      {sectionTitle}
      <span class="text-sm font-normal text-slate-500 uppercase tracking-wider ml-2 hidden sm:inline">{sectionSubtitle}</span>
    </h2>
  </div>

  <div class="bg-white border border-slate-200 rounded-sm shadow-sm">
    <ul id="news-list" class="divide-y divide-slate-100">
      {/* 🌟 這裡改為映射 sortedNewsData 而不是原本的 newsData */}
      {sortedNewsData.map((item, index) => (
        <li class="group news-item" hidden={index >= 5} inert={index >= 5}>
          {/* 🌟 根據 isPinned 動態加入灰底背景色與 hover 效果 */}
          <button type="button" id={`news-toggle-${item.slug}`} aria-expanded="false" aria-controls={`news-content-${item.slug}`} class={`news-toggle-btn w-full text-left transition-colors flex flex-col md:flex-row md:items-center px-6 py-5 gap-4 justify-between focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-blue-600 ${item.isPinned ? 'bg-slate-50 hover:bg-slate-100' : 'bg-transparent hover:bg-slate-50'}`}>
            <div class="flex flex-col md:flex-row md:items-center gap-4">
              {/* 🌟 左側寬度改用 md:w-[17rem]，以容納新增的置頂標籤 */}
              <div class="flex items-center gap-3 shrink-0 md:w-[17rem]">
                <time datetime={item.date.replaceAll('.', '-')} class="text-slate-500 font-mono text-sm tracking-tight">{item.date}</time>
                <span class={`px-2.5 py-1 text-xs font-medium rounded-sm border shrink-0 ${item.tagTheme}`}>{getDisplayTag(item.slug, item.tag)}</span>
                {/* 🌟 新增：如果設定為置頂，就顯示置頂徽章 */}
                {item.isPinned && (
                  <span class="px-2 py-0.5 text-[11px] font-bold text-red-600 bg-red-50 border border-red-200 rounded shrink-0 flex items-center gap-1 shadow-sm">
                    📌 {pinnedLabel}
                  </span>
                )}
              </div>
              {/* 🌟 根據 isPinned 動態加入粗體 (font-bold) */}
              <span class={`transition group-hover:text-blue-700 ${item.isPinned ? 'text-slate-900 font-bold' : 'text-slate-800 font-medium'}`}>{getDisplayTitle(item.slug, item.title)}</span>
            </div>
            <svg class="w-5 h-5 text-slate-400 toggle-icon transition-transform duration-300 shrink-0 hidden md:block" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
          </button>
          
          {/* 🌟 展開時也延續置頂文章的灰底顏色 */}
          <div id={`news-content-${item.slug}`} role="region" aria-labelledby={`news-toggle-${item.slug}`} hidden inert data-expanded="false" class={item.isPinned ? 'bg-slate-50' : 'bg-transparent'}>
            <div class="overflow-hidden">
              <div class="px-6 pb-6 md:pl-[19rem] text-slate-700 text-sm leading-relaxed space-y-5">
                {item.img && !hasEmbeddedLeadImage(item, getDisplayContent(item)) && (
                  <div class="w-full max-w-3xl mx-auto bg-slate-100 rounded border border-slate-200 overflow-hidden relative mt-2 flex items-center justify-center min-h-[120px]">
                    <span class="absolute text-slate-400 font-medium z-0">[ {getDisplayImgAlt(item)} ]</span>
                    <img src={item.img} alt={getDisplayImgAlt(item)} class="w-full h-auto relative z-10 block" loading="lazy" decoding="async" onerror="this.style.display='none';" />
                  </div>
                )}
                <div set:html={getPreparedContent(item)}></div>
                <div class="pt-2">
                  <a
                    href={`${newsBasePath}/${item.slug}`}
                    class="inline-flex items-center gap-2 rounded-full bg-slate-900 px-4 py-2 text-sm font-bold text-white transition hover:bg-blue-700"
                    aria-label={`${readMoreLabel}: ${getDisplayTitle(item.slug, item.title)}`}
                  >
                    {readMoreLabel}
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                    </svg>
                  </a>
                </div>
              </div>
            </div>
          </div>
        </li>
      ))}
    </ul>
  </div>

  <nav id="pagination-controls" aria-label={isEnglish ? 'News pages' : '新聞分頁'} class="flex flex-wrap justify-center items-center mt-8 gap-2"></nav>
  <noscript>
    <ul class="mt-6 space-y-3">
      {sortedNewsData.map((item) => <li><a class="text-blue-700 underline" href={`${newsBasePath}/${item.slug}`}>{getDisplayTitle(item.slug, item.title)}</a></li>)}
    </ul>
  </noscript>
</section>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const section = document.querySelector('[data-news-root]');
    if (!section) return;
    const isEnglishPage = document.documentElement.lang === 'en';
    const newsItems = Array.from(section.querySelectorAll('.news-item'));
    const pagination = section.querySelector('#pagination-controls');
    const itemsPerPage = 5;
    const totalPages = Math.ceil(newsItems.length / itemsPerPage);
    let currentPage = 1;

    function setExpanded(button, expanded) {
      const content = document.getElementById(button.getAttribute('aria-controls'));
      if (!content) return;
      content.hidden = !expanded;
      content.inert = !expanded;
      content.dataset.expanded = String(expanded);
      button.setAttribute('aria-expanded', String(expanded));
      const icon = button.querySelector('.toggle-icon');
      if (icon) icon.style.transform = expanded ? 'rotate(180deg)' : 'rotate(0deg)';
    }

    section.querySelectorAll('.news-toggle-btn').forEach(button => {
      button.addEventListener('click', () => {
        const expanded = button.getAttribute('aria-expanded') !== 'true';
        section.querySelectorAll('.news-toggle-btn[aria-expanded="true"]').forEach(other => {
          setExpanded(other, false);
        });
        setExpanded(button, expanded);
      });
    });

    function renderPagination() {
      pagination.replaceChildren();
      if (totalPages <= 1) return;

      function addButton(label, page, disabled = false, active = false) {
        const button = document.createElement('button');
        button.type = 'button';
        button.textContent = label;
        button.dataset.page = String(page);
        button.disabled = disabled;
        button.setAttribute('aria-controls', 'news-list');
        if (active) button.setAttribute('aria-current', 'page');
        if (/^\d+$/.test(label)) {
          button.setAttribute('aria-label', isEnglishPage ? `Page ${page}` : `第 ${page} 頁`);
        }
        const colors = active
          ? 'bg-blue-700 text-white border-blue-700 shadow-sm'
          : 'bg-white text-slate-600 border-slate-300 hover:bg-slate-50';
        button.className = `min-w-8 px-3 py-1.5 text-sm font-medium rounded border transition focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 disabled:opacity-30 disabled:cursor-not-allowed ${colors}`;
        pagination.append(button);
      }

      addButton(isEnglishPage ? 'Previous' : '上一頁', currentPage - 1, currentPage === 1);
      for (let page = 1; page <= totalPages; page++) {
        addButton(String(page), page, false, page === currentPage);
      }
      addButton(isEnglishPage ? 'Next' : '下一頁', currentPage + 1, currentPage === totalPages);
    }

    function changePage(page, moveFocus = true) {
      if (page < 1 || page > totalPages) return;
      currentPage = page;
      const first = (page - 1) * itemsPerPage;
      newsItems.forEach((item, index) => {
        const button = item.querySelector('.news-toggle-btn');
        if (button) setExpanded(button, false);
        item.hidden = index < first || index >= first + itemsPerPage;
        item.inert = item.hidden;
      });
      renderPagination();
      if (moveFocus) {
        pagination.querySelector('[aria-current="page"]')?.focus({ preventScroll: true });
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        section.scrollIntoView({ behavior: reducedMotion ? 'auto' : 'smooth', block: 'start' });
      }
    }

    pagination.addEventListener('click', event => {
      const button = event.target.closest('button[data-page]');
      if (button && !button.disabled) changePage(Number(button.dataset.page));
    });
    changePage(1, false);
  });
</script>
