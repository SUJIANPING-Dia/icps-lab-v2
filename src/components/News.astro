---
import { newsData } from "../data/news";

interface Props {
  lang?: "zh" | "en";
}

const { lang = "zh" } = Astro.props;
const isEnglish = lang === "en";
const newsBasePath = isEnglish ? "/en/news" : "/news";
const sectionTitle = isEnglish ? "News" : "最新消息";
const sectionSubtitle = "News & Announcements";
const pinnedLabel = isEnglish ? "Pinned" : "置頂";
const readMoreLabel = isEnglish ? "Read Full Article" : "閱讀完整新聞";
const englishNewsTitles: Record<string, string> = {
  "2026-ai-automation-equipment-award-second-place": "iCPS Lab Team Wins Second Place at the 15th National AI Automation Equipment Creation Award",
  "2026-nstc-t2-pose-three-year-project": "Prof. Wan-Jung Chang Receives Three-Year NSTC Grant for T²-Pose Near-Bed Care Sensing System",
  "2026-consumer-electronics-contribution-award": "Prof. Wan-Jung Chang Receives Outstanding Contribution Award from Taiwan Consumer Electronics Society (TCES)",
  "2026-nstc-undergrad-project-tsai-yiming": "iCPS Lab Undergraduate Student Yi-Ming Tsai Receives NSTC Student Research Grant",
  "2026-medical-taiwan-ai-surgical-instrument-recognition": "iCPS Lab Showcases AI Surgical Instrument Recognition at Medical Taiwan 2026",
  "2026-international-nursing-summit-indonesia": "Prof. Wan-Jung Chang Joins International Nursing Summit 2026 in Bandung, Indonesia",
  "2026-icme-ai-surgical-instrument-award": "iCPS Lab Receives Excellent Poster Submission Recognition at ICME 2026",
  "2026-itaoi-honorable-mention": "iCPS Lab Receives Honorable Mention at ITAOI 2026",
  "2026-neihu-vocational-school-visit": "Neihu Vocational School Visits iCPS Lab",
  "2026-atlife-expo-ai-care": "AI Care Technologies Showcased at the 2026 ATLife Expo",
  "2026-student-project-competition-second-place": "Student Project Team Wins Second Place in National Competition",
  "2026-ustv-ai-smart-glasses-report": "USTV Features iCPS Lab AI Smart Glasses Research",
  "2026-ustv-ar-glasses-tof-interview": "USTV Interview on AR Glasses and ToF Applications",
  "2026-student-project-competition-finalist": "Student Project Team Selected as National Competition Finalist",
  "2026-japan-patent-tongue-rehabilitation": "Japan Patent Granted for Tongue Rehabilitation Game Platform",
  "2026-icct-pacific-papers": "iCPS Lab Presents Papers at ICCT-Pacific 2026",
  "2026-dsp-competition-celebration": "DSP Competition Celebration",
  "2026-website-launch": "iCPS Lab Website Launch",
  "2026-master-student-recruitment": "Master's Student Recruitment Announcement",
};
const getEnglishNewsTag = (slug: string) => {
  if (slug.includes("ai-automation-equipment-award")) return "Competition";
  if (slug.includes("nstc-t2-pose")) return "Research Grant";
  if (slug.includes("contribution-award")) return "Award";
  if (slug.includes("nstc-undergrad-project")) return "Student Honor";
  if (slug.includes("medical-taiwan")) return "Exhibition";
  if (slug.includes("nursing-summit")) return "International";
  if (slug.includes("icme") || slug.includes("itaoi")) return "Award";
  if (slug.includes("neihu")) return "Visit";
  if (slug.includes("atlife")) return "Exhibition";
  if (slug.includes("competition") || slug.includes("dsp")) return "Competition";
  if (slug.includes("ustv")) return "Media";
  if (slug.includes("patent")) return "Patent";
  if (slug.includes("icct")) return "Publication";
  return "Announcement";
};
const getDisplayTitle = (slug: string, fallback: string) => isEnglish ? (englishNewsTitles[slug] ?? fallback) : fallback;
const getDisplayTag = (slug: string, fallback: string) => isEnglish ? getEnglishNewsTag(slug) : fallback;
const hasEmbeddedLeadImage = (item: NewsItem) => Boolean(item.img && item.content.includes(item.img));

const sortedNewsData = [...newsData].sort((a, b) => {
  if (a.isPinned && !b.isPinned) return -1;
  if (!a.isPinned && b.isPinned) return 1;
  return 0;
});
---

<section id="news" class="scroll-mt-12">
  <div class="border-b-2 border-slate-800 pb-3 mb-8 flex justify-between items-end">
    <h2 class="text-3xl font-bold text-slate-900 flex items-center gap-3">
      <div class="w-2 h-8 bg-blue-700"></div>
      {sectionTitle}
      <span class="text-sm font-normal text-slate-500 uppercase tracking-wider ml-2 hidden sm:inline">{sectionSubtitle}</span>
    </h2>
  </div>

  <div class="bg-white border border-slate-200 rounded-sm shadow-sm">
    <ul id="news-list" class="divide-y divide-slate-100">
      {/* 🌟 這裡改為映射 sortedNewsData 而不是原本的 newsData */}
      {sortedNewsData.map((item) => (
        <li class="group news-item">
          {/* 🌟 根據 isPinned 動態加入灰底背景色與 hover 效果 */}
          <button class={`news-toggle-btn w-full text-left transition-colors flex flex-col md:flex-row md:items-center px-6 py-5 gap-4 justify-between focus:outline-none ${item.isPinned ? 'bg-slate-50 hover:bg-slate-100' : 'bg-transparent hover:bg-slate-50'}`}>
            <div class="flex flex-col md:flex-row md:items-center gap-4">
              {/* 🌟 左側寬度改用 md:w-[17rem]，以容納新增的置頂標籤 */}
              <div class="flex items-center gap-3 shrink-0 md:w-[17rem]">
                <span class="text-slate-500 font-mono text-sm tracking-tight">{item.date}</span>
                <span class={`px-2.5 py-1 text-xs font-medium rounded-sm border shrink-0 ${item.tagTheme}`}>{getDisplayTag(item.slug, item.tag)}</span>
                {/* 🌟 新增：如果設定為置頂，就顯示置頂徽章 */}
                {item.isPinned && (
                  <span class="px-2 py-0.5 text-[11px] font-bold text-red-600 bg-red-50 border border-red-200 rounded shrink-0 flex items-center gap-1 shadow-sm">
                    📌 {pinnedLabel}
                  </span>
                )}
              </div>
              {/* 🌟 根據 isPinned 動態加入粗體 (font-bold) */}
              <span class={`transition group-hover:text-blue-700 ${item.isPinned ? 'text-slate-900 font-bold' : 'text-slate-800 font-medium'}`}>{getDisplayTitle(item.slug, item.title)}</span>
            </div>
            <svg class="w-5 h-5 text-slate-400 toggle-icon transition-transform duration-300 shrink-0 hidden md:block" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
          </button>
          
          {/* 🌟 展開時也延續置頂文章的灰底顏色 */}
          <div style="grid-template-rows: 0fr;" data-expanded="false" class={`grid transition-[grid-template-rows] duration-300 ease-in-out ${item.isPinned ? 'bg-slate-50' : 'bg-transparent'}`}>
            <div class="overflow-hidden">
              <div class="px-6 pb-6 md:pl-[19rem] text-slate-700 text-sm leading-relaxed space-y-5">
                {item.img && !hasEmbeddedLeadImage(item) && (
                  <div class="w-full max-w-3xl mx-auto bg-slate-100 rounded border border-slate-200 overflow-hidden relative mt-2 flex items-center justify-center min-h-[120px]">
                    <span class="absolute text-slate-400 font-medium z-0">[ {item.imgAlt} ]</span>
                    <img src={item.img} alt={item.imgAlt} class="w-full h-auto relative z-10 block" onerror="this.style.display='none';" />
                  </div>
                )}
                <div set:html={item.content}></div>
                <div class="pt-2">
                  <a
                    href={`${newsBasePath}/${item.slug}`}
                    class="inline-flex items-center gap-2 rounded-full bg-slate-900 px-4 py-2 text-sm font-bold text-white transition hover:bg-blue-700"
                    aria-label={`${readMoreLabel}: ${getDisplayTitle(item.slug, item.title)}`}
                  >
                    {readMoreLabel}
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                    </svg>
                  </a>
                </div>
              </div>
            </div>
          </div>
        </li>
      ))}
    </ul>
  </div>

  <div id="pagination-controls" class="flex justify-center items-center mt-8 gap-2"></div>
</section>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const isEnglishPage = document.documentElement.lang === 'en';
    const previousPageLabel = isEnglishPage ? 'Previous' : '上一頁';
    const nextPageLabel = isEnglishPage ? 'Next' : '下一頁';
    const toggleButtons = document.querySelectorAll('.news-toggle-btn');
    toggleButtons.forEach(button => {
      button.addEventListener('click', function() {
        const content = this.nextElementSibling;
        const icon = this.querySelector('.toggle-icon');
        const isExpanded = content.getAttribute('data-expanded') === 'true';

        // 🟢 如果要展開當前項目，先收起所有其他已展開的項目
        if (!isExpanded) {
          const allExpanded = document.querySelectorAll('#news-list [data-expanded="true"]');
          allExpanded.forEach(expandedContent => {
            expandedContent.style.gridTemplateRows = '0fr';
            expandedContent.setAttribute('data-expanded', 'false');
            const expandedIcon = expandedContent.previousElementSibling.querySelector('.toggle-icon');
            if (expandedIcon) expandedIcon.style.transform = 'rotate(0deg)';
          });
        }

        // 切換當前項目的狀態
        if (!isExpanded) {
          content.style.gridTemplateRows = '1fr';
          content.setAttribute('data-expanded', 'true');
          if (icon) icon.style.transform = 'rotate(180deg)';
        } else {
          content.style.gridTemplateRows = '0fr';
          content.setAttribute('data-expanded', 'false');
          if (icon) icon.style.transform = 'rotate(0deg)';
        }
      });
    });

    const itemsPerPage = 5;
    let currentPage = 1;
    const newsItems = Array.from(document.querySelectorAll('.news-item'));
    const paginationContainer = document.getElementById('pagination-controls');

    function renderPagination() {
      const totalPages = Math.ceil(newsItems.length / itemsPerPage);
      if (totalPages <= 1) {
        paginationContainer.innerHTML = '';
        return;
      }

      let html = '';
      const prevDisabled = currentPage === 1 ? 'opacity-30 cursor-not-allowed' : 'hover:bg-slate-100 hover:text-slate-800';
      html += `<button onclick="window.changePage(${currentPage - 1})" class="px-3 py-1.5 text-sm font-medium rounded border border-slate-300 text-slate-600 transition ${prevDisabled}" ${currentPage === 1 ? 'disabled' : ''}>${previousPageLabel}</button>`;

      for (let i = 1; i <= totalPages; i++) {
        const activeClass = i === currentPage ? 'bg-blue-700 text-white border-blue-700 shadow-sm' : 'bg-white text-slate-600 border-slate-300 hover:bg-slate-50';
        html += `<button onclick="window.changePage(${i})" class="w-8 h-8 flex items-center justify-center text-sm font-bold rounded border transition ${activeClass}">${i}</button>`;
      }

      const nextDisabled = currentPage === totalPages ? 'opacity-30 cursor-not-allowed' : 'hover:bg-slate-100 hover:text-slate-800';
      html += `<button onclick="window.changePage(${currentPage + 1})" class="px-3 py-1.5 text-sm font-medium rounded border border-slate-300 text-slate-600 transition ${nextDisabled}" ${currentPage === totalPages ? 'disabled' : ''}>${nextPageLabel}</button>`;

      paginationContainer.innerHTML = html;
    }

    window.changePage = function(page, scrollToNews = true) {
      const totalPages = Math.ceil(newsItems.length / itemsPerPage);
      if (page < 1 || page > totalPages) return;
      
      currentPage = page;
      const startIndex = (currentPage - 1) * itemsPerPage;
      const endIndex = startIndex + itemsPerPage;

      newsItems.forEach((item, index) => {
        const content = item.querySelector('[data-expanded]');
        const icon = item.querySelector('.toggle-icon');
        
        // 換頁時自動收合所有展開的項目
        if(content && content.getAttribute('data-expanded') === 'true') {
          content.style.gridTemplateRows = '0fr';
          content.setAttribute('data-expanded', 'false');
          if (icon) icon.style.transform = 'rotate(0deg)';
        }

        if (index >= startIndex && index < endIndex) {
          item.style.display = 'block';
        } else {
          item.style.display = 'none';
        }
      });

      renderPagination();

      if (scrollToNews) {
        const newsSection = document.getElementById('news');
        const elementPosition = newsSection.getBoundingClientRect().top;
        const offsetPosition = elementPosition + window.pageYOffset;
        window.scrollTo({ top: offsetPosition, behavior: 'smooth' });
      }
    };

    window.changePage(1, false);
  });
</script>
