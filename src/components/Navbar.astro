---
interface Props {
  activePath?: string;
}

const { activePath = Astro.url.pathname } = Astro.props;

const links = [
  { href: "/", label: "首頁", english: "Home", match: "/" },
  { href: "/about", label: "關於 iCPS Lab", english: "About", match: "/about" },
  { href: "/#news", label: "最新消息", english: "News", match: "/#news" },
  { href: "/activities", label: "活動花絮", english: "Events", match: "/activities" },
  { href: "/#videos", label: "影音專區", english: "Media", match: "/#videos" },
  { href: "/achievements", label: "成果榮譽", english: "Achievements", match: "/achievements" },
  { href: "/members", label: "實驗室成員", english: "Members", match: "/members" },
  { href: "/faq", label: "常見問題", english: "FAQ", match: "/faq" },
];

const isActive = (match: string) => {
  if (match === "/") return activePath === "/";
  return activePath === match || activePath.startsWith(`${match}/`);
};
---

<nav class="w-full bg-white border-b border-slate-200 shadow-sm relative z-30">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 flex items-center justify-between py-3 md:py-4">
    <div class="flex items-center gap-3 sm:gap-6 lg:gap-8 min-w-0">
      <a href="https://www.nkust.edu.tw/" target="_blank" class="flex items-center shrink-0 transition-transform duration-300 hover:scale-105">
        <img
          src="/images/nkust-logo.png"
          alt="NKUST 國立高雄科技大學"
          class="h-6 sm:h-9 md:h-10 lg:h-11 w-auto object-contain"
          onerror="this.src='https://upload.wikimedia.org/wikipedia/zh/thumb/4/46/National_Kaohsiung_University_of_Science_and_Technology_logo.svg/800px-National_Kaohsiung_University_of_Science_and_Technology_logo.svg.png';"
        />
      </a>
      <div class="h-4 sm:h-6 md:h-8 border-l-[1.5px] border-slate-300/80 shrink-0 rounded-full"></div>
      <a href="/" class="flex items-center shrink-0 transition-transform duration-300 hover:scale-105">
        <img
          src="/images/sicp-logo.png"
          alt="iCPS Lab 智慧網宇實體系統實驗室"
          class="h-7 sm:h-11 md:h-12 lg:h-[3.25rem] w-auto object-contain"
          onerror="this.style.display='none';"
        />
      </a>
    </div>

    <div class="hidden md:flex space-x-8 text-sm font-bold text-slate-600 shrink-0 ml-4">
      {links.map((link) => {
        const active = isActive(link.match);
        return (
          <a
            href={link.href}
            class={`group flex flex-col items-center transition border-b-2 pb-1 ${active ? "text-blue-800 border-blue-800" : "hover:text-blue-800 border-transparent hover:border-blue-800"}`}
          >
            <span>{link.label}</span>
            <span class={`text-xs font-normal ${active ? "text-blue-600" : "text-slate-400 group-hover:text-blue-600"}`}>{link.english}</span>
          </a>
        );
      })}
    </div>

    <button id="mobile-menu-btn" class="md:hidden p-2 text-slate-600 hover:text-blue-800 transition focus:outline-none" aria-label="打開選單">
      <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path id="hamburger-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  <div id="mobile-menu" class="hidden md:hidden absolute top-full left-0 w-full bg-white border-b border-slate-200 shadow-lg flex flex-col z-20">
    {links.map((link) => {
      const active = isActive(link.match);
      return (
        <a
          href={link.href}
          class={`block px-6 py-4 font-bold ${active ? "text-blue-800 bg-blue-50" : "text-slate-600 hover:bg-slate-50 hover:text-blue-800"}`}
        >
          {link.label}
        </a>
      );
    })}
  </div>
</nav>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const mobileMenuBtn = document.getElementById("mobile-menu-btn");
    const mobileMenu = document.getElementById("mobile-menu");
    const hamburgerIcon = document.getElementById("hamburger-icon");

    if (mobileMenuBtn && mobileMenu && hamburgerIcon) {
      mobileMenuBtn.addEventListener("click", () => {
        const isHidden = mobileMenu.classList.contains("hidden");
        mobileMenu.classList.toggle("hidden", !isHidden);
        hamburgerIcon.setAttribute("d", isHidden ? "M6 18L18 6M6 6l12 12" : "M4 6h16M4 12h16M4 18h16");
      });

      mobileMenu.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => {
          mobileMenu.classList.add("hidden");
          hamburgerIcon.setAttribute("d", "M4 6h16M4 12h16M4 18h16");
        });
      });
    }
  });
</script>
