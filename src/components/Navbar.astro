---
interface Props {
  activePath?: string;
  lang?: "zh" | "en";
}

const { activePath = Astro.url.pathname, lang = "zh" } = Astro.props;
const isEnglish = lang === "en";

const links = [
  { href: "/", enHref: "/en", label: "首頁", english: "Home", match: "/", enMatch: "/en" },
  { href: "/about", enHref: "/en/about", label: "關於 iCPS Lab", english: "About", match: "/about", enMatch: "/en/about" },
  { href: "/news", enHref: "/en/news", label: "最新消息", english: "News", match: "/news", enMatch: "/en/news" },
  { href: "/activities", enHref: "/en/activities", label: "活動花絮", english: "Events", match: "/activities", enMatch: "/en/activities" },
  { href: "/videos", enHref: "/en/videos", label: "影音專區", english: "Media", match: "/videos", enMatch: "/en/videos" },
  { href: "/achievements", enHref: "/en/achievements", label: "成果榮譽", english: "Achievements", match: "/achievements", enMatch: "/en/achievements" },
  { href: "/members", enHref: "/en/members", label: "實驗室成員", english: "Members", match: "/members", enMatch: "/en/members" },
  { href: "/faq", enHref: "/en/faq", label: "常見問題", english: "FAQ", match: "/faq", enMatch: "/en/faq" },
];

const getHref = (link: typeof links[number]) => isEnglish && "enHref" in link && link.enHref ? link.enHref : link.href;
const getMatch = (link: typeof links[number]) => isEnglish && "enMatch" in link && link.enMatch ? link.enMatch : link.match;
const getPrimaryLabel = (link: typeof links[number]) => isEnglish ? link.english : link.label;
const getSecondaryLabel = (link: typeof links[number]) => isEnglish ? link.label : link.english;

const isActive = (match: string) => {
  if (match === "/") return activePath === "/";
  if (match === "/en") return activePath === "/en";
  return activePath === match || activePath.startsWith(`${match}/`);
};

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const languagePairs = [
  { zh: "/", en: "/en" },
  { zh: "/about", en: "/en/about" },
  { zh: "/news", en: "/en/news" },
  { zh: "/activities", en: "/en/activities" },
  { zh: "/videos", en: "/en/videos" },
  { zh: "/achievements", en: "/en/achievements" },
  { zh: "/members", en: "/en/members" },
  { zh: "/faq", en: "/en/faq" },
];
const currentPair = languagePairs.find((pair) => pair.zh === currentPath || pair.en === currentPath);
const detailPair = currentPath.startsWith("/en/news/") || currentPath.startsWith("/en/activities/")
  ? { zh: currentPath.replace(/^\/en/, ""), en: currentPath }
  : currentPath.startsWith("/news/") || currentPath.startsWith("/activities/")
    ? { zh: currentPath, en: `/en${currentPath}` }
    : null;
const zhHref = currentPair ? currentPair.zh : detailPair ? detailPair.zh : currentPath.startsWith("/en/") ? currentPath.replace(/^\/en/, "") || "/" : currentPath;
const enHref = currentPair ? currentPair.en : detailPair ? detailPair.en : currentPath.startsWith("/en/") ? currentPath : `/en${currentPath === "/" ? "" : currentPath}`;
---

<nav class="w-full bg-white border-b border-slate-200 shadow-sm relative z-30">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 flex items-center justify-between py-3 md:py-4">
    <div class="flex items-center gap-3 sm:gap-6 lg:gap-8 min-w-0">
      <a href="https://www.nkust.edu.tw/" target="_blank" class="flex items-center shrink-0 transition-transform duration-300 hover:scale-105">
        <img
          src="/images/nkust-logo.png"
          alt="NKUST 國立高雄科技大學"
          class="h-6 sm:h-9 md:h-10 lg:h-11 w-auto object-contain"
          onerror="this.src='https://upload.wikimedia.org/wikipedia/zh/thumb/4/46/National_Kaohsiung_University_of_Science_and_Technology_logo.svg/800px-National_Kaohsiung_University_of_Science_and_Technology_logo.svg.png';"
        />
      </a>
      <div class="h-4 sm:h-6 md:h-8 border-l-[1.5px] border-slate-300/80 shrink-0 rounded-full"></div>
      <a href="/" class="flex items-center shrink-0 transition-transform duration-300 hover:scale-105">
        <img
          src="/images/sicp-logo.png"
          alt="iCPS Lab 智慧網宇實體系統實驗室"
          class="h-7 sm:h-11 md:h-12 lg:h-[3.25rem] w-auto object-contain"
          onerror="this.style.display='none';"
        />
      </a>
    </div>

    <div class="hidden md:flex items-center gap-5 lg:gap-7 text-sm font-bold text-slate-600 shrink-0 ml-4">
      {links.map((link) => {
        const active = isActive(getMatch(link));
        return (
          <a
            href={getHref(link)}
            class={`group flex flex-col items-center transition border-b-2 pb-1 ${active ? "text-blue-800 border-blue-800" : "hover:text-blue-800 border-transparent hover:border-blue-800"}`}
          >
            <span>{getPrimaryLabel(link)}</span>
            <span class={`text-xs font-normal ${active ? "text-blue-600" : "text-slate-400 group-hover:text-blue-600"}`}>{getSecondaryLabel(link)}</span>
          </a>
        );
      })}
      <div class="h-8 border-l border-slate-200"></div>
      <div class="flex items-center rounded-full border border-slate-200 bg-slate-50 p-1 text-xs font-black tracking-wide">
        <a href={zhHref} class={`px-2.5 py-1 rounded-full transition ${isEnglish ? "text-slate-500 hover:text-blue-800" : "bg-white text-blue-800 shadow-sm"}`}>CH</a>
        <a href={enHref} class={`px-2.5 py-1 rounded-full transition ${isEnglish ? "bg-white text-blue-800 shadow-sm" : "text-slate-500 hover:text-blue-800"}`}>EN</a>
      </div>
    </div>

    <button id="mobile-menu-btn" class="md:hidden p-2 text-slate-600 hover:text-blue-800 transition focus:outline-none" aria-label="打開選單">
      <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path id="hamburger-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  <div id="mobile-menu" class="hidden md:hidden absolute top-full left-0 w-full bg-white border-b border-slate-200 shadow-lg flex flex-col z-20">
    {links.map((link) => {
      const active = isActive(getMatch(link));
      return (
        <a
          href={getHref(link)}
          class={`block px-6 py-4 font-bold ${active ? "text-blue-800 bg-blue-50" : "text-slate-600 hover:bg-slate-50 hover:text-blue-800"}`}
        >
          {getPrimaryLabel(link)}
        </a>
      );
    })}
    <div class="flex items-center gap-2 px-6 py-4 border-t border-slate-100 bg-slate-50">
      <a href={zhHref} class={`px-4 py-2 rounded-full text-sm font-black ${isEnglish ? "text-slate-500 bg-white border border-slate-200" : "text-white bg-blue-800"}`}>CH</a>
      <a href={enHref} class={`px-4 py-2 rounded-full text-sm font-black ${isEnglish ? "text-white bg-blue-800" : "text-slate-500 bg-white border border-slate-200"}`}>EN</a>
    </div>
  </div>
</nav>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const mobileMenuBtn = document.getElementById("mobile-menu-btn");
    const mobileMenu = document.getElementById("mobile-menu");
    const hamburgerIcon = document.getElementById("hamburger-icon");

    if (mobileMenuBtn && mobileMenu && hamburgerIcon) {
      mobileMenuBtn.addEventListener("click", () => {
        const isHidden = mobileMenu.classList.contains("hidden");
        mobileMenu.classList.toggle("hidden", !isHidden);
        hamburgerIcon.setAttribute("d", isHidden ? "M6 18L18 6M6 6l12 12" : "M4 6h16M4 12h16M4 18h16");
      });

      mobileMenu.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => {
          mobileMenu.classList.add("hidden");
          hamburgerIcon.setAttribute("d", "M4 6h16M4 12h16M4 18h16");
        });
      });
    }
  });
</script>
